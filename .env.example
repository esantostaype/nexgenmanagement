# Copia este archivo como .env (no se sube al repositorio) y rellena los valores.
# En Vercel: Project → Settings → Environment Variables (las mismas claves).

# Resend → API Keys → Create API Key (permiso "Sending access")
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Quién recibe los formularios
MAIL_TO=esantostaype@gmail.com

# Remitente. Con onboarding@resend.dev Resend solo entrega a tu propio correo de la cuenta: para enviar la
# autorrespuesta a cualquier persona hay que verificar el dominio en Resend (Domains) y usar una dirección suya.
MAIL_FROM=Nex-Gen Management <hello@nexgenmultifamily.com>
