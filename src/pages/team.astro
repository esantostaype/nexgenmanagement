---
import BaseLayout from '@/components/templates/BaseLayout.astro';
import Header from '@/components/organisms/Header.astro';
import Footer from '@/components/organisms/Footer.astro';
import PageHero from '@/components/organisms/sections/PageHero.astro';
import TeamGrid from '@/components/organisms/sections/TeamGrid.astro';
import CoreValues from '@/components/organisms/sections/CoreValues.astro';
---

<BaseLayout
  title="Meet the Team | Nex-Gen Management"
  description="Meet the Nex-Gen Management team in Clarksville, TN, and the core values behind our multifamily property management: COMMUNITY."
  lang="en"
>
  <Header variant="overlay" />
  <main>
    <PageHero
      eyebrow="Meet Nex-Gen"
      title="The people behind every property."
      text="Managers, accountants and coordinators who treat each community like their own."
    />
    <TeamGrid />
    <CoreValues />
  </main>
  <Footer />

  <script>
    import { initHome } from '@/scripts/home';
    initHome();
  </script>
</BaseLayout>
