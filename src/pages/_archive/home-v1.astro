---
// ARCHIVADO: primera versión de la home (antes src/pages/index.astro). La carpeta _archive no genera
// rutas. Para recuperarla, muévela de nuevo a src/pages/ con otro nombre (p. ej. home-v1.astro).
import BaseLayout from '@/components/templates/BaseLayout.astro';
import SiteHeader from '@/components/_archive/home/SiteHeader.astro';
import Hero from '@/components/_archive/home/Hero.astro';
import Footprint from '@/components/_archive/home/Footprint.astro';
import Owners from '@/components/_archive/home/Owners.astro';
import OwnerReport from '@/components/_archive/home/OwnerReport.astro';
import WordPills from '@/components/_archive/home/WordPills.astro';
import Communities from '@/components/_archive/home/Communities.astro';
import Residents from '@/components/_archive/home/Residents.astro';
import HomeSales from '@/components/_archive/home/HomeSales.astro';
import Team from '@/components/_archive/home/Team.astro';
import Proposal from '@/components/_archive/home/Proposal.astro';
import SiteFooter from '@/components/_archive/home/SiteFooter.astro';
---

<BaseLayout
  title="Nex-Gen Management | Multifamily Property Management in TN, KY & AL"
  description="Nex-Gen manages 38 multifamily properties across Tennessee, Kentucky and Alabama. Weekly owner reports, hands-on teams, and a path for residents and home buyers."
  lang="en"
>
  <SiteHeader />
  <main>
    <Hero />
    <Footprint />
    <Owners />
    <OwnerReport />
    <WordPills />
    <Communities />
    <Residents />
    <HomeSales />
    <Team />
    <Proposal />
  </main>
  <SiteFooter />

  <script>
    import { initHome } from '@/scripts/home';
    initHome();
  </script>
</BaseLayout>
