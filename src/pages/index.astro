---
import BaseLayout from '@/components/templates/BaseLayout.astro';
import Header from '@/components/organisms/Header.astro';
import Hero from '@/components/organisms/sections/Hero.astro';
import About from '@/components/organisms/sections/About.astro';
import Services from '@/components/organisms/sections/Services.astro';
import Leadership from '@/components/organisms/sections/Leadership.astro';
import Properties from '@/components/organisms/sections/Properties.astro';
import Testimonials from '@/components/organisms/sections/Testimonials.astro';
import News from '@/components/organisms/sections/News.astro';
import Footer from '@/components/organisms/Footer.astro';
---

<BaseLayout
  title="Nex-Gen Management | Multifamily Property Management in TN, KY & AL"
  description="Award-winning multifamily property management. Nex-Gen runs 38 properties across Tennessee, Kentucky and Alabama for owners and investors."
  lang="en"
>
  <Header variant="overlay" />
  <main>
    <Hero />
    <About />
    <Services />
    <Leadership />
    <Properties />
    <Testimonials />
    <News />
  </main>
  <Footer />

  <script>
    import { initHome } from '@/scripts/home';
    initHome();
  </script>
</BaseLayout>
