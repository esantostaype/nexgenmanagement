---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/home2/Header.astro';
// Hero original (sin corte): import Hero from '@/components/home2/Hero.astro';
import Hero from '@/components/home2/HeroNotch.astro';
import About from '@/components/home2/About.astro';
import Services from '@/components/home2/ServicesSticky.astro';
import Leadership from '@/components/home2/Leadership.astro';
import Communities from '@/components/home2/Communities.astro';
import Testimonials from '@/components/home2/Testimonials.astro';
import News from '@/components/home2/News.astro';
import Footer from '@/components/home2/Footer.astro';
---

<BaseLayout
  title="Nex-Gen Management | Multifamily Property Management in TN, KY & AL"
  description="Award-winning multifamily property management. Nex-Gen runs 38 properties across Tennessee, Kentucky and Alabama for owners and investors."
  lang="en"
>
  <Header variant="overlay" />
  <main>
    <Hero />
    <About />
    <Services />
    <Leadership />
    <Communities />
    <Testimonials />
    <News />
  </main>
  <Footer />

  <script>
    import { initHome } from '@/scripts/home';
    initHome();
  </script>
</BaseLayout>
