---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Imagen para compartir 1200×630. Por defecto, la captura del hero (scripts/og.mjs) */
  image?: string;
  imageAlt?: string;
  lang?: string;
}

const {
  title,
  description = 'Nex-Gen Management: multifamily property management for owners and investors across Tennessee, Kentucky and Alabama.',
  image = '/og/og.jpg',
  imageAlt = 'Nex-Gen Management: multifamily management that protects your asset and the people who live in it.',
  lang = 'en',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
// Variantes de la captura por defecto: 2:1 para X y cuadrada para vistas previas recortadas
const isDefaultImage = image === '/og/og.jpg';
const xImage = new URL(isDefaultImage ? '/og/og-x.jpg' : image, Astro.site);
const squareImage = new URL('/og/og-square.jpg', Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- Sitio en desarrollo: que los buscadores no lo indexen. Quitar al publicar en producción -->
    <meta name="robots" content="noindex, nofollow" />
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- Precarga Inter y define --font-inter con un fallback de métricas ajustadas (sin salto al cargar) -->
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-hanken" preload />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- Favicon: SVG con modo claro/oscuro (media query interna); .ico y apple-touch-icon de respaldo -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Compartir: Open Graph (Facebook, LinkedIn, WhatsApp, Slack, Discord, iMessage…) y X -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nex-Gen Management" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {
      isDefaultImage && (
        <>
          <meta property="og:image" content={squareImage} />
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="1200" />
          <meta property="og:image:alt" content={imageAlt} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@NexGenMFM" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={xImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- View transitions: navegación en el cliente con transición entre páginas (src/scripts/lifecycle.ts) -->
    <ClientRouter />

    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <slot />

    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
