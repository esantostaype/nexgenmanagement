---
// Icono Tabler + texto en línea (ciudad, fecha…).
// `truncate`: el texto se corta con "…" en una línea. Va en su propio <span> (min-w-0 + truncate): en un contenedor
// flex, text-overflow no pinta los puntos suspensivos si se aplica al contenedor; el icono no se encoge.
interface Props {
  icon: (props: Record<string, unknown>) => unknown;
  /** Color del icono */
  iconClass?: string;
  truncate?: boolean;
  class?: string;
}

const { icon: Icon, iconClass = '', truncate = false, class: className } = Astro.props;
---

<span class:list={[truncate ? 'flex max-w-full min-w-0' : 'inline-flex', 'items-center gap-1.5', className]}>
  <Icon class:list={['size-4 shrink-0', iconClass]} stroke-width="1.75" aria-hidden="true" />
  <span class:list={[truncate && 'min-w-0 truncate']}><slot /></span>
</span>
