---
// Texto secundario de tarjeta, bajo CardTitle. `flush` quita el margen superior (cuando no hay título encima).
interface Props {
  as?: 'span' | 'p';
  tone?: 'dark' | 'light';
  flush?: boolean;
  class?: string;
}

const { as: Tag = 'span', tone = 'dark', flush = false, class: className } = Astro.props;
---

<Tag class:list={['block', !flush && 'mt-1', tone === 'light' ? 'text-brand-100/75' : 'text-neutral-600', className]}>
  <slot />
</Tag>
