---
// Píldora translúcida con texto y flecha, encima de una imagen ("Read more"). Gira con el hover del `group` padre.
import ArrowCircle from '@/components/atoms/ArrowCircle.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['inline-flex items-center gap-3 rounded-full bg-brand-950/45 py-1.5 pr-1.5 pl-4 text-sm font-medium text-white backdrop-blur-md', className]}>
  <slot />
  <ArrowCircle tone="light" size="sm" />
</span>
