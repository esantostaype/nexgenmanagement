---
// Círculo con flecha (→ en reposo, ↗ en hover del `group` padre). Lo usan ArrowButton y las tarjetas enlazadas.
import ArrowUpRight from '@tabler/icons/outline/arrow-up-right.svg';

interface Props {
  /** dark: brand-950 con flecha cian · brand: cian con flecha oscura · light: blanco con flecha oscura */
  tone?: 'dark' | 'brand' | 'light' | 'dark-white';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { tone = 'dark', size = 'lg', class: className } = Astro.props;

const tones = {
  dark: 'bg-brand-950 text-brand-300',
  'dark-white': 'bg-brand-950 text-white',
  brand: 'bg-brand-400 text-brand-950',
  light: 'bg-white text-brand-950',
}[tone];
const sizes = { sm: 'size-8', md: 'size-9', lg: 'size-10' }[size];
---

<span
  class:list={['grid shrink-0 place-items-center rounded-full transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] rotate-45 group-hover:rotate-0', tones, sizes, className]}
  aria-hidden="true"
>
  <ArrowUpRight class={size === 'sm' ? 'size-4' : 'size-4.5'} stroke-width={size === 'sm' ? '2' : '1.75'} />
</span>
