---
// Línea de tiempo vertical: año destacado a la izquierda y, a la derecha, un punto sobre la línea con el título y una
// frase. El último hito va en celeste (el presente).
interface Props {
  items: { year: string; title: string; text: string }[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ol class:list={['grid', className]} data-reveal-stagger>
  {
    items.map((item, i) => {
      const last = i === items.length - 1;
      return (
        <li class="grid grid-cols-[4.5rem_minmax(0,1fr)] gap-x-4 sm:grid-cols-[6rem_minmax(0,1fr)] sm:gap-x-6">
          <span class:list={['font-display text-2xl leading-none font-semibold tabular-nums sm:text-3xl', last ? 'text-brand-500' : 'text-brand-950']}>{item.year}</span>
          <span class:list={['relative block border-l pl-6 sm:pl-8', last ? 'border-transparent' : 'border-brand-950/10 pb-10']}>
            <span class:list={['absolute top-1 -left-1.5 size-3 rounded-full ring-4 ring-background', last ? 'bg-brand-400' : 'bg-brand-950']} aria-hidden="true" />
            <span class="font-display block text-lg leading-tight font-semibold text-brand-950">{item.title}</span>
            <span class="mt-1.5 block leading-relaxed text-neutral-600">{item.text}</span>
          </span>
        </li>
      );
    })
  }
</ol>
