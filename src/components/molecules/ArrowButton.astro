---
// Botón píldora con círculo de flecha a la derecha (CTA principal del sitio), sobre el Button de Starwind.
// La flecha apunta a → en reposo y gira a ↗ en hover (convención del proyecto).
// Cualquier atributo extra (data-*, tabindex, aria-*) pasa al <a>/<button>. Con `opens` abre un Dialog de Starwind.
import type { HTMLAttributes } from 'astro/types';
import { Button } from '@/components/starwind/button';
import ArrowCircle from '@/components/atoms/ArrowCircle.astro';

interface Props extends Omit<HTMLAttributes<'a'>, 'type'> {
  href?: string;
  /** id de un Dialog de Starwind: el botón lo abre en lugar de navegar (p. ej. el modal de propuesta) */
  opens?: string;
  variant?: 'brand' | 'dark' | 'light';
  size?: 'md' | 'lg';
  /** Abre en otra pestaña */
  external?: boolean;
  /** Botón de formulario en lugar de enlace */
  type?: 'button' | 'submit';
  class?: string;
}

const { href, opens, variant = 'brand', size = 'lg', external = false, type, class: className, ...rest } = Astro.props;
// Abre un diálogo: es un <button> con los atributos que el Dialog de Starwind reconoce como disparador
const dialogTrigger = opens ? { 'data-sw-dialog-trigger': '', 'data-sw-dialog-target-id': opens, 'aria-haspopup': 'dialog' as const } : {};

// Color del círculo según la variante (contraste con el fondo del botón)
const dot = ({ brand: 'dark', dark: 'brand', light: 'dark-white' } as const)[variant];
---

<Button
  href={opens ? undefined : href}
  type={href && !opens ? undefined : (type ?? 'button')}
  variant={variant}
  shape="pill"
  size={size === 'lg' ? 'pill-lg' : 'pill-md'}
  class:list={['group active:scale-[0.98]', className]}
  {...(external && !opens ? { target: '_blank', rel: 'noopener' } : {})}
  {...dialogTrigger}
  {...rest}
>
  <slot />
  <ArrowCircle tone={dot} size={size === 'lg' ? 'lg' : 'md'} />
</Button>
