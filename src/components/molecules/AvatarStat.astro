---
// Grupo de avatares + dato en dos líneas (p. ej. "38 properties" / "15 cities · TN, KY, AL"). Con href es un enlace
// y la burbuja "+" gira al pasar el ratón.
import AvatarGroup from '@/components/molecules/AvatarGroup.astro';

interface Props {
  items: { src?: string; name?: string }[];
  title: string;
  text?: string;
  href?: string;
  /** Color del fondo donde se apoya (anillo de los avatares) */
  ring?: 'white' | 'background';
  class?: string;
  [key: `data-${string}`]: string | undefined;
}

const { items, title, text, href, ring = 'background', class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag href={href} class:list={['group flex items-center gap-2.5 text-sm md:gap-3', className]} {...rest}>
  <AvatarGroup items={items} more ring={ring} moreClass="transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:rotate-90" />
  <span class="leading-tight">
    <span class="font-display block text-base font-semibold">{title}</span>
    {text && <span class="text-neutral-500">{text}</span>}
  </span>
</Tag>
