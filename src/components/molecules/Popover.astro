---
// Tarjeta flotante con pico abajo, centrado (tarjeta de propiedad sobre el mapa). El contenido va en el slot.
// Entra con un pequeño rebote al aparecer (p. ej. al clonarse desde un <template>).
interface Props {
  /** Ancho de la tarjeta */
  width?: string;
  class?: string;
}

const { width = 'w-65', class: className } = Astro.props;
---

<div class:list={['popover relative rounded-2xl shadow-[0_24px_48px_-20px_rgb(7_53_69/0.5)]', width, className]}>
  <slot />
  <span class="absolute -bottom-1.5 left-1/2 size-3 -translate-x-1/2 rotate-45 rounded-md bg-white" aria-hidden="true"></span>
</div>

<style>
  .popover {
    transform-origin: 50% 100%;
    animation: popover-in 0.4s cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  @keyframes popover-in {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.94);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .popover {
      animation: none;
    }
  }
</style>
