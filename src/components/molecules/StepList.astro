---
// Pasos numerados en vertical, unidos por una línea (proceso de un servicio).
interface Props {
  title: string;
  items: string[];
  class?: string;
}

const { title, items, class: className } = Astro.props;
---

<div class={className}>
  <p class="text-xs font-semibold tracking-[0.12em] text-neutral-500 uppercase">{title}</p>
  <ol class="mt-4 grid gap-0" data-reveal-stagger data-stagger="0.06">
    {
      items.map((item, i) => (
        <li class="relative flex gap-4 pb-5 last:pb-0">
          {i < items.length - 1 && <span class="absolute top-8 bottom-0 left-4 w-px bg-brand-950/10" aria-hidden="true" />}
          <span class="font-display relative grid size-8 shrink-0 place-items-center rounded-full bg-brand-950 text-sm font-semibold text-brand-300 tabular-nums">{i + 1}</span>
          <span class="pt-1 text-[0.95rem] leading-snug text-brand-950">{item}</span>
        </li>
      ))
    }
  </ol>
</div>
