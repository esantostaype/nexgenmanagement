---
// Botón de llamada con borde del color actual: número completo desde xl, "Call us" por debajo (oculto en móvil).
import { Button } from '@/components/starwind/button';
import Phone from '@tabler/icons/outline/phone.svg';

interface Props {
  phone: string;
  href: string;
  class?: string;
}

const { phone, href, class: className } = Astro.props;
---

<Button href={href} variant="contrast" shape="pill" class:list={['size-12 md:size-auto md:h-12 gap-2.5 text-[0.95rem] inline-flex', className]} aria-label={`Call ${phone}`}>
  <Phone class="size-4.5" stroke-width="1.75" />
  <span class="hidden tabular-nums md:inline">{phone}</span>
</Button>
