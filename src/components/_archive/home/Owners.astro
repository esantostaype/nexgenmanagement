---
import Check from '@tabler/icons/outline/check.svg';
import PillLink from '@/components/_archive/PillLink.astro';
import { lifecycle } from '@/data/site';

// Cada etapa tiene su propio material: teal profundo, cian, teal medio y blanco.
const skins = [
  'bg-brand-950 text-white',
  'bg-brand-400 text-brand-950',
  'bg-brand-800 text-white',
  'bg-white text-brand-950 ring-1 ring-brand-950/6',
];
---

<section id="owners" class="scroll-mt-24 px-3 pt-24 sm:px-4 md:pt-32" aria-labelledby="owners-title">
  <div class="mx-auto max-w-360">
    <div class="grid items-end gap-8 px-2 lg:grid-cols-12 lg:px-6">
      <h2
        id="owners-title"
        class="font-display text-[clamp(2.2rem,4.6vw,4rem)] leading-none font-semibold tracking-[-0.035em] text-balance text-brand-950 lg:col-span-7"
        data-reveal
      >
        From the first walkthrough to the weekly report.
      </h2>
      <div class="lg:col-span-5" data-reveal data-delay="0.15">
        <p class="max-w-[46ch] text-lg leading-relaxed text-neutral-600">
          Whether you are evaluating an acquisition or tuning a stabilized asset, one team carries it through
          every stage, and you see every number.
        </p>
      </div>
    </div>

    <ol class="mt-14 grid gap-3 md:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {
        lifecycle.map((stage, i) => (
          <li class:list={['relative flex min-h-75 flex-col overflow-hidden rounded-2xl p-7 md:min-h-95', skins[i]]}>
            <div class="relative">
              <h3 class="font-display text-[1.75rem] leading-tight font-semibold ">{stage.step}</h3>
              <p class:list={['mt-3 text-[0.95rem] leading-relaxed', i === 1 ? 'text-brand-950/80' : i === 3 ? 'text-neutral-600' : 'text-white/80']}>
                {stage.text}
              </p>
            </div>
            <div class="relative mt-auto pt-8">
              <ul class="flex flex-col gap-2 text-sm">
                {stage.services.map((service) => (
                  <li class="flex items-center gap-2">
                    <Check class:list={['size-4 shrink-0', i === 1 ? 'text-brand-950' : 'text-brand-400']} stroke-width="2" />
                    {service}
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-4 rounded-2xl bg-white px-6 py-5 ring-1 ring-brand-950/6" data-reveal>
      <p class="max-w-[60ch] text-neutral-600">
        Not sure which stage you are in? Send us the address. We will walk the property and tell you what we see.
      </p>
      <PillLink href="#proposal" variant="dark">Request a free property analysis</PillLink>
    </div>
  </div>
</section>
