---
import Mail from '@tabler/icons/outline/mail.svg';
import PillLink from '@/components/_archive/PillLink.astro';
import { contact, realtors } from '@/data/site';

const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .slice(0, 2)
    .join('');
---

<section id="home-sales" class="scroll-mt-24 px-3 pt-24 sm:px-4 md:pt-32" aria-labelledby="sales-title">
  <div class="mx-auto grid max-w-360 overflow-hidden rounded-2xl bg-white ring-1 ring-brand-950/6 lg:grid-cols-12">
    <div class="p-7 sm:p-10 lg:col-span-7 lg:p-14">
      <h2 id="sales-title" class="font-display text-[clamp(2rem,4vw,3.4rem)] leading-[1.02] font-semibold  text-balance text-brand-950" data-reveal>
        Buying or selling a home in Clarksville?
      </h2>
      <p class="mt-5 max-w-[52ch] text-lg leading-relaxed text-neutral-600" data-reveal data-delay="0.15">
        Nex-Gen Home Sales pairs local market knowledge with a property manager’s eye. You get advice that
        understands the transaction and what owning the place will actually be like.
      </p>
      <div class="mt-9 flex flex-wrap gap-3" data-reveal data-delay="0.25">
        <PillLink href={`mailto:${contact.email}?subject=Buying%20a%20home`} variant="dark">Buy a home</PillLink>
        <PillLink href={`mailto:${contact.email}?subject=Selling%20my%20home`} variant="ghost-dark">Sell my home</PillLink>
      </div>
    </div>

    <div class="flex flex-col justify-between gap-10 bg-brand-50 p-7 sm:p-10 lg:col-span-5 lg:p-14">
      <p class="font-display text-lg font-semibold tracking-tight text-brand-950">Your Nex&#8209;Gen realtors</p>
    <ul class="flex flex-col border-t border-brand-950/10" data-reveal-stagger>
      {
        realtors.map((r) => (
          <li class="flex items-center gap-4 border-b border-brand-950/10 py-5">
            <span class="font-display grid size-14 shrink-0 place-items-center rounded-full bg-brand-950 text-lg font-semibold text-brand-300">
              {initials(r.name)}
            </span>
            <span class="min-w-0 flex-1">
              <span class="font-display block font-semibold tracking-tight text-brand-950">{r.name}</span>
              <span class="block text-sm text-neutral-500">{r.role}</span>
            </span>
            <a
              href={`mailto:${r.email}`}
              class="grid size-11 shrink-0 place-items-center rounded-full ring-1 ring-brand-950/10 transition-colors hover:bg-brand-950 hover:text-white"
              aria-label={`Email ${r.name}`}
            >
              <Mail class="size-5" stroke-width="1.75" />
            </a>
          </li>
        ))
      }
    </ul>
      <p class="text-sm text-neutral-600">
        Serving Clarksville and the surrounding area · <a href={contact.phoneHref} class="font-medium text-brand-950 underline underline-offset-4 hover:text-brand-700">{contact.phone}</a>
      </p>
    </div>
  </div>
</section>
