---
import Img from '@/components/atoms/Img.astro';
import type { Community } from '@/data/communities';

interface Props {
  community: Community;
}

const { community } = Astro.props;
---

<!-- Llavero de comunidad: silueta troquelada (extremo afilado + agujero recortado) y el logo completo en su placa -->
<span class="tag-wrap inline-flex shrink-0">
  <span class="tag inline-flex items-center gap-4 bg-white py-2.5 pr-6 pl-11">
    <span class="grid h-14 w-21 shrink-0 place-items-center overflow-hidden rounded-xl bg-white ring-1 ring-neutral-200">
      <Img sizes="84px" src={community.logo} alt="" width="84" height="58" loading="lazy" decoding="async" class="size-full object-contain" />
    </span>
    <span class="flex flex-col leading-tight">
      <span class="font-display text-[0.95rem] font-semibold tracking-tight text-brand-950">{community.name}</span>
      <span class="mt-0.5 text-xs text-neutral-500">{community.city}, {community.state}</span>
    </span>
  </span>
</span>

<style>
  /* Una sola elevación: la sombra sigue la silueta recortada (drop-shadow en el contenedor) */
  .tag-wrap {
    filter: drop-shadow(0 6px 10px rgb(7 53 69 / 0.12));
  }

  /* Extremo izquierdo afilado y esquinas derechas achaflanadas, como una etiqueta de llavero */
  .tag {
    clip-path: polygon(22px 0, calc(100% - 10px) 0, 100% 10px, 100% calc(100% - 10px), calc(100% - 10px) 100%, 22px 100%, 0 calc(50% + 12px), 0 calc(50% - 12px));
    /* Agujero troquelado de verdad: deja ver el fondo */
    mask: radial-gradient(circle at 20px 50%, transparent 6px, #000 6.5px);
  }
</style>
