---
import Img from '@/components/atoms/Img.astro';
import { communities, cities, states } from '@/data/communities';
import { TO_CONFIRM, photos } from '@/data/site';

const byState = states.map((state) => ({
  state,
  count: communities.filter((c) => c.state === state).length,
}));

const stateNames: Record<string, string> = { TN: 'Tennessee', KY: 'Kentucky', AL: 'Alabama' };

const figures = [
  { value: String(communities.length), label: 'properties under management' },
  { value: String(cities.length), label: 'cities across the region' },
  { value: String(states.length), label: 'states: TN, KY and AL' },
  { value: TO_CONFIRM, label: 'apartment homes', pending: true },
];
---

<section class="px-3 pt-24 sm:px-4 md:pt-32" aria-labelledby="footprint-title">
  <div class="relative mx-auto max-w-360 overflow-hidden rounded-2xl bg-brand-950 text-white">
    <Img sizes="100vw"
      src={photos.dusk.src}
      alt=""
      width="2000"
      height="1236"
      loading="lazy"
      class="absolute inset-0 size-full object-cover opacity-35"
      data-parallax
    />
    <div class="absolute inset-0 bg-linear-to-r from-brand-950 via-brand-950/85 to-brand-950/40" aria-hidden="true"></div>

    <div class="relative grid gap-14 p-7 sm:p-10 lg:grid-cols-12 lg:p-14">
      <div class="lg:col-span-5">
        <h2 id="footprint-title" class="font-display text-[clamp(2rem,4vw,3.4rem)] leading-[1.02] font-semibold  text-balance" data-reveal>
          A regional operator, close to every property.
        </h2>
        <p class="mt-5 max-w-[42ch] text-brand-100/80" data-reveal data-delay="0.15">
          Our managers drive these roads every week. That proximity is how small issues stay small.
        </p>
        <ul class="mt-10 flex flex-wrap gap-2" data-reveal-stagger>
          {
            byState.map(({ state, count }) => (
              <li class="flex items-center gap-3 rounded-full bg-white/8 py-2 pr-4 pl-2 ring-1 ring-white/12">
                <span class="grid size-8 place-items-center rounded-full bg-brand-400 text-xs font-bold text-brand-950">{state}</span>
                <span class="text-sm">
                  {stateNames[state]} · <span class="tabular-nums">{count}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <dl class="grid grid-cols-2 gap-px self-end overflow-hidden rounded-2xl bg-white/12 lg:col-span-7" data-reveal-stagger>
        {
          figures.map((f) => (
            <div class="flex flex-col-reverse justify-end gap-3 bg-brand-950/80 p-6 sm:p-8">
              <dt class="text-sm text-brand-100/75">{f.label}</dt>
              <dd
                class:list={[
                  'font-display leading-none font-semibold tracking-[-0.04em] tabular-nums',
                  f.pending ? 'flex min-h-[clamp(3rem,6vw,5.5rem)] items-end text-2xl text-brand-300/80' : 'text-[clamp(3rem,6vw,5.5rem)]',
                ]}
                data-count={f.pending ? undefined : f.value}
              >
                {f.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
