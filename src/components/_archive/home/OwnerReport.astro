---
import FileText from '@tabler/icons/outline/file-text.svg';
import CalendarWeek from '@tabler/icons/outline/calendar-week.svg';
import Tool from '@tabler/icons/outline/tool.svg';
import CashBanknote from '@tabler/icons/outline/cash-banknote.svg';

// Datos ilustrativos: el informe es una demostración del formato, no resultados reales.
const weeks = [88, 90, 89, 92, 93, 92, 95, 96];
const kpis = [
  { label: 'Occupancy', value: '96.1%', delta: '+1.4 pts' },
  { label: 'Rent collected', value: '98.3%', delta: 'of billed' },
  { label: 'Work orders closed', value: '42 / 44', delta: 'avg. 1.6 days' },
];
const notes = [
  'Pool resurfacing finished on schedule, under budget.',
  'Two move-ins this week, one notice to vacate.',
  'Annual inspection booked for building C.',
];

const points = [
  { icon: CalendarWeek, title: 'Every week', text: 'Occupancy, leasing, collections and maintenance, in one page.' },
  { icon: CashBanknote, title: 'Every month', text: 'Full financials: revenue, expenses, cash flow and variance to budget.' },
  { icon: Tool, title: 'Every year', text: 'Inspections of structure, systems, safety and code compliance.' },
];
---

<section class="px-3 pt-24 sm:px-4 md:pt-32" aria-labelledby="report-title">
  <div class="mx-auto grid max-w-360 gap-3 lg:grid-cols-12">
    <div class="flex flex-col justify-between rounded-2xl bg-white p-7 ring-1 ring-brand-950/6 sm:p-10 lg:col-span-5">
      <div>
        <h2 id="report-title" class="font-display text-[clamp(2rem,4vw,3.4rem)] leading-[1.02] font-semibold  text-balance text-brand-950" data-reveal>
          Your asset, on one page, every Monday.
        </h2>
        <p class="mt-5 max-w-[44ch] text-neutral-600" data-reveal data-delay="0.15">
          No chasing your manager for numbers. The report arrives before you think to ask, with what changed
          and what we are doing about it.
        </p>
      </div>
      <ul class="mt-12 flex flex-col divide-y divide-brand-950/8" data-reveal-stagger>
        {
          points.map((p) => (
            <li class="flex gap-4 py-5">
              <span class="grid size-11 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-700">
                <p.icon class="size-5" stroke-width="1.75" />
              </span>
              <span>
                <span class="font-display block font-semibold tracking-tight text-brand-950">{p.title}</span>
                <span class="text-sm text-neutral-600">{p.text}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative overflow-hidden rounded-2xl bg-brand-100 p-4 sm:p-8 lg:col-span-7 lg:p-12">

      <article
        class="relative mx-auto max-w-155 rounded-2xl bg-white p-5 shadow-[0_40px_80px_-40px_rgb(7_53_69/0.45)] sm:p-7"
        data-reveal="scale"
        aria-label="Sample weekly owner report with illustrative figures"
      >
        <header class="flex flex-wrap items-center justify-between gap-3 border-b border-brand-950/8 pb-5">
          <div class="flex items-center gap-3">
            <span class="grid size-10 place-items-center rounded-full bg-brand-950 text-brand-300">
              <FileText class="size-5" stroke-width="1.75" />
            </span>
            <span class="leading-tight">
              <span class="font-display block font-semibold tracking-tight text-brand-950">Weekly owner report</span>
              <span class="text-xs text-neutral-500">Your property · Week 41</span>
            </span>
          </div>
          <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-medium text-amber-900">Sample · illustrative figures</span>
        </header>

        <dl class="grid grid-cols-1 gap-3 py-5 sm:grid-cols-3">
          {
            kpis.map((k) => (
              <div class="rounded-2xl bg-neutral-50 p-4">
                <dt class="text-xs text-neutral-500">{k.label}</dt>
                <dd class="font-display mt-1 text-2xl font-semibold tracking-tight text-brand-950 tabular-nums">{k.value}</dd>
                <dd class="text-xs text-brand-700">{k.delta}</dd>
              </div>
            ))
          }
        </dl>

        <figure>
          <figcaption class="mb-3 flex items-center justify-between text-xs text-neutral-500">
            <span>Occupancy, last 8 weeks</span>
            <span class="tabular-nums">85%–100%</span>
          </figcaption>
          <div class="flex h-36 items-end gap-2" data-bars>
            {
              weeks.map((w, i) => (
                <span class="flex h-full flex-1 flex-col justify-end">
                  <span
                    class:list={['block origin-bottom rounded-t-lg', i === weeks.length - 1 ? 'bg-brand-500' : 'bg-brand-200']}
                    style={`height: ${((w - 85) / 15) * 100}%`}
                    data-bar
                  />
                </span>
              ))
            }
          </div>
        </figure>

        <ul class="mt-5 flex flex-col gap-2 border-t border-brand-950/8 pt-5 text-sm text-neutral-700">
          {notes.map((n) => <li class="flex gap-2"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-brand-500" aria-hidden="true" />{n}</li>)}
        </ul>
      </article>
    </div>
  </div>
</section>
