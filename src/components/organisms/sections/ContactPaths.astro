---
// Atajos de contacto: una tarjeta por perfil (dueño, residente, comprador/vendedor, candidato) que lleva a su página.
import Section from '@/components/atoms/Section.astro';
import IconCircle from '@/components/atoms/IconCircle.astro';
import ArrowCircle from '@/components/atoms/ArrowCircle.astro';
import SectionHeading from '@/components/molecules/SectionHeading.astro';
import InfoCard from '@/components/molecules/InfoCard.astro';
import { contactPaths } from '@/data/forms';
import { featureIcons } from '@/lib/feature-icons';
---

<Section id="paths" labelledby="paths-title">
  <SectionHeading id="paths-title" eyebrow="Find your way" title="What brings you to Nex-Gen?" layout="split" />
  <ul class="grid-gap mt-10 grid sm:grid-cols-2 lg:mt-12 lg:grid-cols-4" data-reveal-stagger>
    {
      contactPaths.map((p) => (
        <li>
          <InfoCard href={p.href} title={p.title} text={p.text} class="group h-full transition-shadow duration-500 hover:shadow-[0_24px_48px_-28px_rgb(7_53_69/0.5)]" tall>
            <IconCircle slot="top" icon={featureIcons[p.icon]} size="sm" />
            <ArrowCircle slot="aside" />
          </InfoCard>
        </li>
      ))
    }
  </ul>
</Section>
