---
// Ritmo de reportes: línea de tiempo Semanal → Mensual → Anual sobre un panel oscuro a todo el ancho.
// Asimétrica: cabecera a la izquierda (5 columnas) y la línea de tiempo a la derecha (7).
import Section from '@/components/atoms/Section.astro';
import SectionHeading from '@/components/molecules/SectionHeading.astro';
import ArrowLink from '@/components/molecules/ArrowLink.astro';

interface Props {
  steps: { when: string; title: string; text: string; slug: string }[];
}

const { steps } = Astro.props;
---

<Section id="rhythm" labelledby="rhythm-title" width="inset" innerClass="rounded-2xl bg-brand-950 py-14 text-white md:py-20 lg:py-24">
  <div class="container-site grid gap-12 lg:grid-cols-12 lg:gap-16">
    <SectionHeading id="rhythm-title" eyebrow="Reporting rhythm" eyebrowTone="dark" tone="light" title="You always know where your property stands." class="lg:col-span-5">
      <p>A steady cadence of reports and checks, so nothing about your asset is a surprise.</p>
    </SectionHeading>

    <ol class="grid gap-4 sm:grid-cols-3 lg:col-span-7" data-reveal-stagger>
      {
        steps.map((step, i) => (
          <li class="relative flex flex-col rounded-2xl bg-white/6 p-6">
            <!-- Conector hacia el siguiente paso -->
            {i < steps.length - 1 && <span class="absolute top-9 -right-4 hidden h-px w-4 bg-brand-400/40 sm:block" aria-hidden="true" />}
            <span class="flex items-center gap-3">
              <span class="grid size-6 place-items-center rounded-full bg-brand-400 text-xs font-semibold text-brand-950 tabular-nums">{i + 1}</span>
              <span class="text-xs font-semibold tracking-[0.12em] text-brand-300 uppercase">{step.when}</span>
            </span>
            <span class="font-display mt-6 block text-xl font-semibold">{step.title}</span>
            <span class="mt-2 block flex-1 text-[0.95rem] leading-relaxed text-brand-100/75">{step.text}</span>
            <ArrowLink href={`#${step.slug}`} size="sm" tone="light" class="mt-6 text-white">
              See details
            </ArrowLink>
          </li>
        ))
      }
    </ol>
  </div>
</Section>
