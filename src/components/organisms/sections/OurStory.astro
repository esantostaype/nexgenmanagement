---
// Nuestra historia: cabecera fija a la izquierda con las cifras actuales (KeyStat) y, a la derecha, la línea de tiempo
// de hitos en una tarjeta blanca.
import Section from '@/components/atoms/Section.astro';
import Card from '@/components/atoms/Card.astro';
import SectionHeading from '@/components/molecules/SectionHeading.astro';
import KeyStat from '@/components/molecules/KeyStat.astro';
import Timeline from '@/components/molecules/Timeline.astro';
import { aboutTimeline } from '@/data/about';
import { communities, cities, states } from '@/data/communities';
---

<Section id="story" labelledby="story-title" innerClass="grid gap-10 lg:grid-cols-12 lg:gap-16">
  <div class="lg:col-span-5">
    <div class="lg:sticky lg:top-32">
      <SectionHeading id="story-title" eyebrow="Our story" title="Born in Clarksville, built for multifamily.">
        <p>The only management company in Clarksville focused on multifamily, for assets of 48 units or more.</p>
      </SectionHeading>
      <div class="action-gap flex flex-wrap gap-x-8 gap-y-5" data-reveal-stagger>
        <KeyStat value={communities.length} label="Properties" sublabel="Under management" />
        <KeyStat value={cities.length} label="Cities" sublabel="Where we work" />
        <KeyStat value={states.length} label="States" sublabel="TN · KY · AL" />
      </div>
    </div>
  </div>

  <Card class="lg:col-span-7" data-reveal>
    <Timeline items={aboutTimeline} />
  </Card>
</Section>
