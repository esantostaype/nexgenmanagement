---
// Valores de la empresa: sus iniciales forman COMMUNITY. Panel brand-950 a todo el ancho: la palabra grande con las
// letras resaltadas arriba y una tarjeta por valor (letra, palabra y una frase).
import Section from '@/components/atoms/Section.astro';
import SectionHeading from '@/components/molecules/SectionHeading.astro';
import InfoCard from '@/components/molecules/InfoCard.astro';
import { coreValues } from '@/data/team';
---

<Section id="values" labelledby="values-title" width="inset" innerClass="rounded-2xl bg-brand-950 py-14 text-white md:py-20 lg:py-24">
  <div class="container-site">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-16">
      <SectionHeading id="values-title" eyebrow="Our core values" eyebrowTone="dark" tone="light" title="What COMMUNITY means to us." class="lg:col-span-5">
        <p>Nine values, one word. They guide how we treat residents, owners and each other.</p>
      </SectionHeading>
      <!-- La palabra, letra a letra -->
      <p class="font-display flex flex-wrap gap-x-1 text-[clamp(2.75rem,8vw,6.5rem)] leading-none font-semibold tracking-tight lg:col-span-7 lg:justify-end" aria-hidden="true" data-reveal-stagger data-stagger="0.05">
        {coreValues.map((v) => <span class="text-brand-400">{v.letter}</span>)}
      </p>
    </div>

    <ul class="grid-gap mt-12 grid sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
      {
        coreValues.map((v) => (
          <li>
            <InfoCard tone="glass" title={v.word} text={v.text} class="h-full">
              <span slot="top" class="font-display grid size-12 place-items-center rounded-full bg-brand-400 text-xl font-semibold text-brand-950" aria-hidden="true">
                {v.letter}
              </span>
            </InfoCard>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
