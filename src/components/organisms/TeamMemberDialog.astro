---
// Ficha de una persona del equipo en un modal: retrato claro con la cabeza asomando (como las tarjetas) a la izquierda
// y, a la derecha, cargo, nombre, el valor de COMMUNITY que se ve en su bio, la bio, su trayectoria y aficiones.
// Lo abre su ProfileCard (opens={bioDialogId(slug)}).
import { DialogDescription, DialogHeader, DialogTitle } from '@/components/starwind/dialog';
import Modal from '@/components/organisms/Modal.astro';
import Eyebrow from '@/components/atoms/Eyebrow.astro';
import PortraitFrame from '@/components/molecules/PortraitFrame.astro';
import ChipGroup from '@/components/molecules/ChipGroup.astro';
import Callout from '@/components/molecules/Callout.astro';
import StepList from '@/components/molecules/StepList.astro';
import Heart from '@tabler/icons/outline/heart-handshake.svg';
import { bioDialogId, type TeamMember } from '@/data/team';

interface Props {
  member: TeamMember & { bio: NonNullable<TeamMember['bio']> };
}

const { member } = Astro.props;
const { bio } = member;
const label = 'text-xs font-semibold tracking-[0.12em] text-neutral-500 uppercase';
---

<Modal id={bioDialogId(member.slug)} size="lg">
  <!-- Sin relleno extra arriba: la cabeza que sobresale del retrato invade el margen del modal -->
  <div class="grid gap-6 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-10">
    <!-- En escritorio el retrato se queda fijo mientras el texto hace scroll -->
    <div class="md:sticky md:top-0 md:self-start">
      <PortraitFrame name={member.name} photo={member.photo} sizes="(min-width: 768px) 360px, 100vw" tone="light" popout />
    </div>

    <div>
      <DialogHeader class="pr-10 text-left">
        <Eyebrow tone="brand" class="w-fit">{member.role}</Eyebrow>
        <DialogTitle class="font-display heading-gap text-[clamp(1.8rem,3.4vw,2.6rem)] leading-[1.05] font-medium text-brand-950">
          {member.name}
        </DialogTitle>
        <DialogDescription class="sr-only">Bio of {member.name}, {member.role} at Nex-Gen Management.</DialogDescription>
      </DialogHeader>

      <Callout label="Core value" title={bio.value.word} text={bio.value.text} icon={Heart} class="mt-6 rounded-lg" />

      <div class="mt-8">
        <p class={label}>Bio</p>
        <div class="mt-3 grid gap-3 leading-relaxed text-neutral-600">
          {bio.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>

      {bio.experience && <StepList title="Experience" items={bio.experience.map((e) => `${e.years} · ${e.title}: ${e.text}`)} class="mt-8" />}

      {bio.personal && <ChipGroup title="Off the clock" items={bio.personal} tone="neutral" class="mt-8" />}
    </div>
  </div>
</Modal>
