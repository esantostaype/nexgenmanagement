---
// Barra de filtros del mapa: búsqueda por propiedad o ciudad + pastillas de estado. La lógica está en properties-map.ts.
import SearchField from '@/components/molecules/SearchField.astro';
import SegmentedControl from '@/components/molecules/SegmentedControl.astro';

interface Props {
  states: readonly string[];
  class?: string;
}

const { states, class: className } = Astro.props;
---

<form
  class:list={['flex flex-col gap-2 rounded-2xl bg-white p-2 shadow-[0_24px_48px_-24px_rgb(7_53_69/0.45)] sm:flex-row sm:items-center sm:rounded-full', className]}
  data-map-filter
  role="search"
  data-reveal="fade-down"
>
  <SearchField name="q" label="Search by property or city" />
  <SegmentedControl name="state" legend="State" options={[{ value: '', label: 'All' }, ...states.map((st) => ({ value: st, label: st }))]} />
</form>
