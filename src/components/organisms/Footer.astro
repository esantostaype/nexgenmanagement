---
// Footer: logo + suscripción, frase con CTA, columnas de enlaces, contacto, legal y redes.
import { PROPOSAL_DIALOG } from '@/data/forms';
import Logo from '@/assets/brand/logo-full.svg';
import NewsletterSignup from '@/components/molecules/NewsletterSignup.astro';
import CtaBlock from '@/components/molecules/CtaBlock.astro';
import LinkList from '@/components/molecules/LinkList.astro';
import ContactList from '@/components/molecules/ContactList.astro';
import SocialLinks from '@/components/molecules/SocialLinks.astro';
import { contact, social } from '@/data/site';
import { liveNav } from '@/data/navigation';

const year = new Date().getFullYear();

// Columnas basadas en el menú principal (solo páginas que ya existen)
const columns = [{ title: 'Explore', links: liveNav }];
---

<!-- Mismo espaciado superior que las secciones (section-space) y mismos márgenes que los paneles a todo el ancho -->
<footer class="section-space px-3 pb-3 sm:px-4 sm:pb-4">
  <div class="rounded-2xl bg-brand-950 text-brand-100">
    <div class="container-site">
      <div class="flex flex-col gap-8 border-b border-white/10 py-10 lg:flex-row lg:items-center lg:justify-between" data-reveal="fade">
        <a href="/" aria-label="Nex-Gen Management home" class="w-fit">
          <Logo class="h-14 w-auto text-white" role="img" aria-hidden="true" />
        </a>
        <NewsletterSignup title="Stay in the loop" text="Market news, fair housing updates and Nex‑Gen events." />
      </div>

      <div class="grid gap-12 py-14 lg:grid-cols-12 lg:py-16">
        <CtaBlock text="Your property, managed like it’s our own." opens={PROPOSAL_DIALOG} label="Get a proposal" tone="light" class="lg:col-span-5" />
        <div class="grid gap-10 sm:grid-cols-2 lg:col-span-7" data-reveal-stagger>
          {columns.map((col) => <LinkList title={col.title} links={col.links} />)}
          <ContactList title="Get in touch" contact={contact} />
        </div>
      </div>

      <div class="flex flex-col-reverse gap-6 border-t border-white/10 py-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-xs text-brand-100/60">© {year} Nex‑Gen Management, LLC. All rights reserved. · Equal Housing Opportunity</p>
        <SocialLinks items={social} />
      </div>
    </div>
  </div>
</footer>
