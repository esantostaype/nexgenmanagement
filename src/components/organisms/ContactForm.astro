---
// Formulario de contacto con componentes de Starwind (Select, Input, Textarea): mismos campos que el de
// nexgenmultifamily.com/contact.html (nombre, email, teléfono, asunto y mensaje), con el asunto como selector de
// motivo. Valida en el navegador; el envío aún no está conectado (src/scripts/forms.ts).
import FormField from '@/components/molecules/FormField.astro';
import ArrowButton from '@/components/molecules/ArrowButton.astro';
import { Input } from '@/components/starwind/input';
import { Textarea } from '@/components/starwind/textarea';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/starwind/select';
import { contactSubjects } from '@/data/forms';
import { contact } from '@/data/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const id = (name: string) => `contact-${name}`;
---

<form class:list={['grid gap-5', className]} novalidate data-contact-form data-contact-phone={contact.phone} data-contact-email={contact.email}>
  <div class="grid gap-5 sm:grid-cols-2">
    <FormField for={id('name')} label="Your name">
      <Input id={id('name')} name="name" autocomplete="name" required class="h-12" />
    </FormField>
    <FormField for={id('email')} label="Email">
      <Input id={id('email')} name="email" type="email" autocomplete="email" required class="h-12" />
    </FormField>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <FormField for={id('phone')} label="Phone" optional>
      <Input id={id('phone')} name="phone" type="tel" autocomplete="tel" class="h-12" />
    </FormField>
    <FormField for={id('subject')} label="Subject">
      <Select name="subject" defaultValue={contactSubjects[0].value}>
        <SelectTrigger id={id('subject')} class="h-12 w-full">
          <SelectValue placeholder="Choose one" />
        </SelectTrigger>
        <SelectContent>
          {contactSubjects.map((s) => <SelectItem value={s.value}>{s.label}</SelectItem>)}
        </SelectContent>
      </Select>
    </FormField>
  </div>

  <FormField for={id('message')} label="Message">
    <Textarea id={id('message')} name="message" rows={5} placeholder="How can we help?" />
  </FormField>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="min-h-5 text-sm text-neutral-600 data-[tone=error]:text-red-600" role="status" aria-live="polite" data-form-status></p>
    <ArrowButton type="submit" variant="dark" class="shrink-0">Send message</ArrowButton>
  </div>
</form>

<script>
  import { onEveryPage } from '@/scripts/lifecycle';
  import { bindPendingForm } from '@/scripts/forms';

  onEveryPage(() => {
    const cleanups = [...document.querySelectorAll<HTMLFormElement>('[data-contact-form]')].map((form) =>
      bindPendingForm(form, { required: 'Add your name so we know who to reply to.' }),
    );
    return () => cleanups.forEach((c) => c());
  });
</script>
