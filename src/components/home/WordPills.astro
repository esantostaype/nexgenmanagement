---
import Img from '@/components/Img.astro';
import ArrowRight from '@tabler/icons/outline/arrow-right.svg';
import { photos } from '@/data/site';
---

<section class="px-3 pt-24 sm:px-4 md:pt-32" aria-label="We manage homes">
  <div class="mx-auto grid max-w-360 grid-cols-2 gap-3 md:grid-cols-4" data-reveal-stagger data-stagger="0.12">
    <div class="grid h-32 place-items-center rounded-full bg-white ring-1 ring-brand-950/6 sm:h-44">
      <span class="font-display text-[clamp(2.4rem,6vw,5rem)] font-semibold tracking-[-0.04em] text-brand-950">We</span>
    </div>
    <div class="relative grid h-32 place-items-center overflow-hidden rounded-full sm:h-44">
      <Img sizes="(min-width: 768px) 25vw, 50vw" src={photos.pool.src} alt="" width="1536" height="1024" loading="lazy" class="absolute inset-0 size-full object-cover" />
      <span class="absolute inset-0 bg-brand-950/35" aria-hidden="true"></span>
      <span class="font-display relative text-[clamp(2.4rem,6vw,5rem)] font-semibold tracking-[-0.04em] text-white">manage</span>
    </div>
    <div class="grid h-32 place-items-center rounded-full bg-brand-400 sm:h-44" data-pill-arrow>
      <ArrowRight class="size-[clamp(3rem,7vw,5.5rem)] text-brand-950" stroke-width="1.5" />
    </div>
    <div class="relative grid h-32 place-items-center overflow-hidden rounded-full sm:h-44">
      <Img sizes="(min-width: 768px) 25vw, 50vw" src={photos.living.src} alt="" width="1536" height="1024" loading="lazy" class="absolute inset-0 size-full object-cover" />
      <span class="absolute inset-0 bg-brand-950/35" aria-hidden="true"></span>
      <span class="font-display relative text-[clamp(2.4rem,6vw,5rem)] font-semibold tracking-[-0.04em] text-white">homes</span>
    </div>
  </div>
</section>
