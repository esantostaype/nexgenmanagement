---
import Img from '@/components/Img.astro';
import ArrowUpRight from '@tabler/icons/outline/arrow-up-right.svg';
import CommunityTag from './CommunityTag.astro';
import { communities, states } from '@/data/communities';

const half = Math.ceil(communities.length / 2);
const rows = [communities.slice(0, half), communities.slice(half)];

const filters = [
  { id: 'all', label: 'All states', count: communities.length },
  ...states.map((state) => ({ id: state, label: state, count: communities.filter((c) => c.state === state).length })),
];

const sorted = [...communities].sort((a, b) => a.state.localeCompare(b.state) || a.city.localeCompare(b.city) || a.name.localeCompare(b.name));
---

<section id="communities" class="scroll-mt-24 pt-24 md:pt-32" aria-labelledby="communities-title">
  <div class="mx-auto max-w-360 px-5 sm:px-6 lg:px-10">
    <div class="grid items-end gap-8 lg:grid-cols-12">
      <h2
        id="communities-title"
        class="font-display text-[clamp(2.2rem,4.6vw,4rem)] leading-none font-semibold tracking-[-0.035em] text-balance text-brand-950 lg:col-span-7"
        data-reveal
      >
        {communities.length} properties. Every one has a name, and a manager who knows it.
      </h2>
      <p class="max-w-[44ch] text-lg leading-relaxed text-neutral-600 lg:col-span-5" data-reveal data-delay="0.15">
        Looking for a home? Pick a property and visit its site to see floor plans and availability.
      </p>
    </div>
  </div>

  <!-- Marquee de tags de comunidades -->
  <div class="marquee mt-8 -mb-5 flex flex-col gap-3 overflow-hidden py-6" aria-hidden="true">
    {
      rows.map((row, r) => (
        <div class="marquee-track flex w-max gap-3" data-direction={r === 0 ? 'left' : 'right'}>
          {[...row, ...row].map((c) => <CommunityTag community={c} />)}
        </div>
      ))
    }
  </div>

  <!-- Directorio filtrable -->
  <div class="mx-auto mt-14 max-w-360 px-3 sm:px-4">
    <div class="rounded-2xl bg-white p-3 ring-1 ring-brand-950/6 sm:p-4" data-directory>
      <div class="flex flex-wrap items-center justify-between gap-4 px-3 pt-3 pb-5 sm:px-5">
        <p class="font-display text-xl font-semibold tracking-tight text-brand-950">Property directory</p>
        <div role="tablist" aria-label="Filter by state" class="relative flex rounded-full bg-neutral-100 p-1" data-filter-group>
          <span
            class="absolute inset-y-1 left-0 rounded-full bg-brand-950 transition-[transform,width] duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]"
            data-filter-indicator
            aria-hidden="true"
          >
          </span>
          {
            filters.map((f, i) => (
              <button
                type="button"
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                data-filter={f.id}
                class="relative z-10 rounded-full px-4 py-2 text-sm font-medium whitespace-nowrap text-neutral-600 transition-colors duration-300 aria-selected:text-white"
              >
                {f.label} <span class="tabular-nums opacity-60">{f.count}</span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="overflow-hidden rounded-2xl ring-1 ring-brand-950/6">
        <table class="w-full text-left">
          <thead class="bg-neutral-50 text-xs text-neutral-500">
            <tr>
              <th scope="col" class="px-5 py-3 font-medium">Property</th>
              <th scope="col" class="hidden px-5 py-3 font-medium sm:table-cell">City</th>
              <th scope="col" class="hidden px-5 py-3 font-medium md:table-cell">State</th>
              <th scope="col" class="px-5 py-3 text-right font-medium"><span class="sr-only">Website</span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-brand-950/6" data-directory-body>
            {
              sorted.map((c, i) => (
                <tr data-state={c.state} data-row class:list={['group transition-colors hover:bg-brand-50/60', i >= 8 && 'is-collapsed']}>
                  <td class="px-5 py-3">
                    <span class="flex items-center gap-4">
                      <span class="grid h-11 w-16 shrink-0 place-items-center overflow-hidden rounded-xl bg-white ring-1 ring-neutral-200"><Img sizes="64px" src={c.logo} alt="" width="64" height="44" loading="lazy" class="size-full object-contain" /></span>
                      <span>
                        <span class="font-display block font-semibold tracking-tight text-brand-950">{c.name}</span>
                        <span class="text-sm text-neutral-500 sm:hidden">{c.city}, {c.state}</span>
                      </span>
                    </span>
                  </td>
                  <td class="hidden px-5 py-3 text-neutral-600 sm:table-cell">{c.city}</td>
                  <td class="hidden px-5 py-3 md:table-cell">
                    <span class="rounded-full bg-neutral-100 px-2.5 py-1 text-xs font-medium text-neutral-700">{c.state}</span>
                  </td>
                  <td class="px-5 py-3 text-right">
                    {c.url ? (
                      <a
                        href={c.url}
                        target="_blank"
                        rel="noopener"
                        class="inline-grid size-10 place-items-center rounded-full ring-1 ring-brand-950/10 transition-[background-color,color,transform] duration-300 group-hover:bg-brand-950 group-hover:text-white rotate-45 hover:rotate-0"
                        aria-label={`Visit ${c.name} website`}
                      >
                        <ArrowUpRight class="size-[18px]" stroke-width="1.75" />
                      </a>
                    ) : (
                      <span class="text-xs text-neutral-400">Site coming soon</span>
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="flex justify-center pt-4 pb-1">
        <button
          type="button"
          data-directory-more
          class="rounded-full px-5 py-2.5 text-sm font-medium text-brand-950 ring-1 ring-brand-950/12 transition-colors hover:bg-brand-950/5"
        >
          Show all {communities.length} properties
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-track {
    animation: marquee 70s linear infinite;
  }

  .marquee-track[data-direction='right'] {
    animation-direction: reverse;
    animation-duration: 80s;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee {
    to {
      transform: translateX(calc(-50% - 0.375rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }

  [data-directory]:not([data-expanded]) tr.is-collapsed {
    display: none;
  }
</style>
