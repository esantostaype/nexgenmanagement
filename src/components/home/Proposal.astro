---
import Phone from '@tabler/icons/outline/phone.svg';
import Mail from '@tabler/icons/outline/mail.svg';
import MapPin from '@tabler/icons/outline/map-pin.svg';
import Clock from '@tabler/icons/outline/clock.svg';
import ArrowUpRight from '@tabler/icons/outline/arrow-up-right.svg';
import { Input } from '@/components/starwind/input';
import { Label } from '@/components/starwind/label';
import { Textarea } from '@/components/starwind/textarea';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/starwind/select';
import { contact } from '@/data/site';

const audiences = [
  { value: 'owner', label: 'Property owner or investor' },
  { value: 'resident', label: 'Resident or future resident' },
  { value: 'buyer-seller', label: 'Home buyer or seller' },
  { value: 'job', label: 'Looking for a job' },
];

const details = [
  { icon: Phone, label: contact.phone, href: contact.phoneHref },
  { icon: Mail, label: contact.email, href: `mailto:${contact.email}` },
  { icon: MapPin, label: contact.address.join(', '), href: contact.mapsHref },
  { icon: Clock, label: contact.hours },
];
---

<section id="proposal" class="scroll-mt-24 px-3 pt-24 pb-3 sm:px-4 md:pt-32" aria-labelledby="proposal-title">
  <div class="mx-auto grid max-w-360 gap-3 lg:grid-cols-12">
    <div class="flex flex-col justify-between rounded-2xl bg-brand-950 p-7 text-white sm:p-10 lg:col-span-5 lg:p-14">
      <div>
        <h2 id="proposal-title" class="font-display text-[clamp(2.2rem,4.6vw,4rem)] leading-none font-semibold tracking-[-0.035em] text-balance" data-reveal>
          Let’s talk about your property.
        </h2>
        <p class="mt-6 max-w-[40ch] text-lg text-brand-100/80" data-reveal data-delay="0.15">
          Tell us what you own and what you need. A manager, not a call center, will get back to you within one
          business day.
        </p>
      </div>
      <ul class="mt-12 flex flex-col gap-1" data-reveal-stagger>
        {
          details.map((d) => (
            <li>
              {d.href ? (
                <a href={d.href} class="flex items-center gap-3 rounded-2xl py-2.5 transition-colors hover:text-brand-300">
                  <d.icon class="size-5 shrink-0 text-brand-400" stroke-width="1.75" />
                  {d.label}
                </a>
              ) : (
                <span class="flex items-center gap-3 py-2.5">
                  <d.icon class="size-5 shrink-0 text-brand-400" stroke-width="1.75" />
                  {d.label}
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>

    <form
      class="rounded-2xl bg-white p-7 ring-1 ring-brand-950/6 sm:p-10 lg:col-span-7 lg:p-14"
      data-proposal-form
      novalidate
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <div class="grid gap-2 sm:col-span-2">
          <Label for="audience">I am a…</Label>
          <Select name="audience" defaultValue="owner">
            <SelectTrigger id="audience" class="w-full">
              <SelectValue placeholder="Choose one" />
            </SelectTrigger>
            <SelectContent>
              {audiences.map((a) => <SelectItem value={a.value}>{a.label}</SelectItem>)}
            </SelectContent>
          </Select>
        </div>
        <div class="grid gap-2">
          <Label for="name">Full name</Label>
          <Input id="name" name="name" autocomplete="name" required />
        </div>
        <div class="grid gap-2">
          <Label for="email">Email</Label>
          <Input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="grid gap-2">
          <Label for="phone">Phone <span class="text-neutral-400">(optional)</span></Label>
          <Input id="phone" name="phone" type="tel" autocomplete="tel" />
        </div>
        <div class="grid gap-2" data-owner-only>
          <Label for="units">Units or properties</Label>
          <Input id="units" name="units" inputmode="numeric" placeholder="e.g. 120 units, 2 properties" />
        </div>
        <div class="grid gap-2 sm:col-span-2">
          <Label for="message">How can we help?</Label>
          <Textarea id="message" name="message" rows={4} placeholder="Property address, current situation, timeline…" />
        </div>
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
        <p class="max-w-[38ch] text-sm text-neutral-500" data-form-status role="status" aria-live="polite">
          We only use your details to answer this request.
        </p>
        <button
          type="submit"
          class="group inline-flex h-14 items-center gap-4 rounded-full bg-brand-950 pr-2 pl-6 font-medium text-white transition-[background-color,transform] duration-300 hover:bg-brand-900 active:scale-[0.98] disabled:opacity-60"
        >
          Send request
          <span class="grid size-10 place-items-center rounded-full bg-brand-400 text-brand-950 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] rotate-45 group-hover:rotate-0">
            <ArrowUpRight class="size-[18px]" stroke-width="1.75" />
          </span>
        </button>
      </div>
    </form>
  </div>
</section>
