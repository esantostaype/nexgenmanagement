---
import Quote from '@tabler/icons/filled/quote.svg';
import ArrowLeft from '@tabler/icons/outline/arrow-left.svg';
import ArrowRight from '@tabler/icons/outline/arrow-right.svg';
import { realTestimonials } from '@/data/site';

// Iniciales para el avatar (no hay fotos de los clientes)
const initials = (name: string) =>
  name
    .split(' ')
    .map((w) => w[0])
    .slice(0, 2)
    .join('');
---

<!-- Testimonios: a la izquierda comillas, título y controles (flechas + barra de progreso);
     a la derecha un carrusel en bucle que avanza solo y se pausa al pasar el ratón (home.ts, [data-testimonials]) -->
<section class="overflow-x-clip pt-24 md:pt-32" aria-labelledby="testimonials-title" data-testimonials>
  <div class="container-site grid gap-10 lg:grid-cols-12 lg:gap-8">
    <div class="flex flex-col lg:col-span-3">
      <Quote class="size-16 text-neutral-300 md:size-20" data-reveal="scale" />
      <h2 id="testimonials-title" class="font-display mt-6 text-[clamp(2rem,4vw,3.4rem)] leading-[1.05] font-semibold tracking-[-0.03em] text-balance text-brand-950" data-scene="split-lines">
        What our customers are saying
      </h2>
      <div class="mt-8 flex items-center gap-4 lg:mt-auto" data-reveal="from-left">
        <button type="button" class="grid size-10 place-items-center rounded-full text-brand-950 transition-colors hover:text-brand-600" aria-label="Previous testimonials" data-testi-prev>
          <ArrowLeft class="size-5" stroke-width="1.75" />
        </button>
        <span class="relative h-0.5 w-28 overflow-hidden rounded-full bg-brand-950/15" aria-hidden="true">
          <span class="absolute inset-y-0 left-0 w-1/3 rounded-full bg-brand-950 transition-transform duration-700 ease-[cubic-bezier(0.34,1.4,0.64,1)] will-change-transform" data-testi-bar></span>
        </span>
        <button type="button" class="grid size-10 place-items-center rounded-full text-brand-950 transition-colors hover:text-brand-600" aria-label="Next testimonials" data-testi-next>
          <ArrowRight class="size-5" stroke-width="1.75" />
        </button>
      </div>
    </div>

    <!-- Ventana del carrusel: recorta las tarjetas y, en escritorio, llega hasta el borde derecho del navegador -->
    <div class="testi-bleed -mx-4 cursor-grab touch-pan-y overflow-hidden px-4 select-none data-[dragging]:cursor-grabbing lg:col-span-9 lg:mx-0 lg:px-0" data-testi-viewport>
    <ul class="flex gap-4 will-change-transform" data-testi-track data-reveal-stagger>
      {
        realTestimonials.map((t) => (
          <li class="w-[85%] shrink-0 sm:w-[340px]">
            <figure class="relative flex h-full min-h-[300px] flex-col rounded-2xl bg-white p-6 pb-24">
              <Quote class="size-7 text-brand-200" aria-hidden="true" />
              <blockquote class="mt-4 leading-relaxed text-pretty text-neutral-600">{t.quote}</blockquote>
              <!-- Pestaña del autor: recorta la esquina inferior izquierda de la tarjeta con radios invertidos -->
              <figcaption class="testi-tab absolute bottom-0 left-0 flex items-center gap-3 bg-background pt-3 pr-5">
                <span class="testi-corner testi-corner--top" aria-hidden="true" />
                <span class="testi-corner testi-corner--right" aria-hidden="true" />
                <span class="grid size-11 shrink-0 place-items-center rounded-full bg-brand-950 text-sm font-semibold text-brand-300" aria-hidden="true">
                  {initials(t.name)}
                </span>
                <span class="font-display font-semibold text-brand-950">{t.name}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
    </div>
  </div>
</section>

<style>
  /* En escritorio el carrusel sale del container hasta el borde derecho del navegador */
  @media (min-width: 1024px) {
    .testi-bleed {
      margin-right: calc(-1 * max(1rem, (100vw - 1320px) / 2));
    }
  }

  .testi-tab {
    --notch-r: 1rem;
    border-top-right-radius: var(--notch-r);
  }

  /* Radio invertido (misma técnica que el hero): cuadrado con un círculo transparente en la esquina opuesta */
  .testi-corner {
    position: absolute;
    width: var(--notch-r);
    height: var(--notch-r);
    background: radial-gradient(circle at 100% 0, transparent calc(var(--notch-r) - 0.5px), var(--background) var(--notch-r));
    pointer-events: none;
  }
  .testi-corner--top {
    bottom: 100%;
    left: 0;
  }
  .testi-corner--right {
    bottom: 0;
    left: 100%;
  }
</style>
