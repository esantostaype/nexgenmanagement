---
import Logo from '@/assets/brand/logo-full.svg';
import ArrowUpRight from '@tabler/icons/outline/arrow-up-right.svg';
import Phone from '@tabler/icons/outline/phone.svg';
import MapPin from '@tabler/icons/outline/map-pin.svg';
import Mail from '@tabler/icons/outline/mail.svg';
import Clock from '@tabler/icons/outline/clock.svg';
import Facebook from '@tabler/icons/outline/brand-facebook.svg';
import Instagram from '@tabler/icons/outline/brand-instagram.svg';
import Linkedin from '@tabler/icons/outline/brand-linkedin.svg';
import BrandX from '@tabler/icons/outline/brand-x.svg';
import { contact, social } from '@/data/site';

const year = new Date().getFullYear();

// Columnas basadas en el menú principal (solo páginas que ya existen)
const columns = [
  {
    title: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Our properties', href: '/our-properties' },
      { label: 'Services', href: '/#services' },
    ],
  },
];

const icons = { facebook: Facebook, instagram: Instagram, linkedin: Linkedin, x: BrandX };
---

<footer class="px-4 pt-24 pb-4 md:pt-32">
  <div class="rounded-2xl bg-brand-950 text-brand-100">
    <div class="container-site">
      <!-- Logo + suscripción -->
      <div class="flex flex-col gap-8 border-b border-white/10 py-10 lg:flex-row lg:items-center lg:justify-between" data-reveal="fade">
        <a href="/" aria-label="Nex-Gen Management home" class="w-fit">
          <Logo class="h-14 w-auto text-white" role="img" aria-hidden="true" />
        </a>
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
          <div class="sm:text-right">
            <p class="font-display font-semibold text-white">Stay in the loop</p>
            <p class="text-sm text-brand-100/60">Market news, fair housing updates and Nex‑Gen events.</p>
          </div>
          <form class="relative w-full sm:w-auto" novalidate data-newsletter>
            <div class="flex h-14 items-center rounded-full bg-white/8 p-1.5 pl-5 ring-1 ring-white/12 focus-within:ring-brand-400 sm:w-[400px]">
              <label for="newsletter-email" class="sr-only">Email address</label>
              <input id="newsletter-email" name="email" type="email" required autocomplete="email" placeholder="your@email.com" class="h-full min-w-0 flex-1 appearance-none rounded-none border-0! bg-transparent! p-0! text-sm text-white shadow-none! ring-0! outline-none! placeholder:text-brand-100/45" />
              <button type="submit" class="group inline-flex h-full shrink-0 items-center gap-2 rounded-full bg-brand-400 px-5 text-sm font-medium text-brand-950 transition-colors hover:bg-brand-300">
                Subscribe
                <ArrowUpRight class="size-4 rotate-45 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:rotate-0" stroke-width="2" />
              </button>
            </div>
            <p class="absolute top-full left-0 mt-2 pl-5 text-xs text-brand-100/70 data-[tone=error]:text-red-300" role="status" aria-live="polite" data-newsletter-status></p>
          </form>
        </div>
      </div>

      <!-- Mensaje + columnas + contacto -->
      <div class="grid gap-12 py-14 lg:grid-cols-12 lg:py-16">
        <div class="lg:col-span-5">
          <p class="font-display max-w-[16ch] text-[clamp(1.9rem,3.2vw,2.6rem)] leading-[1.1] font-semibold tracking-[-0.025em] text-white" data-scene="split-lines">
            Your property, managed like it’s our own.
          </p>
          <a href="/contact" class="group mt-8 inline-flex h-14 items-center gap-4 rounded-full bg-brand-400 pr-2 pl-6 font-medium text-brand-950 transition-colors hover:bg-brand-300" data-reveal="from-left">
            Get a proposal
            <span class="grid size-10 place-items-center rounded-full bg-brand-950 text-brand-300">
              <ArrowUpRight class="size-5 rotate-45 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:rotate-0" stroke-width="1.75" />
            </span>
          </a>
        </div>

        <div class="grid gap-10 sm:grid-cols-2 lg:col-span-7" data-reveal-stagger>
          {
            columns.map((col) => (
              <nav aria-label={col.title}>
                <p class="font-display font-semibold text-white">{col.title}</p>
                <ul class="mt-5 flex flex-col gap-3 text-[0.95rem]">
                  {col.links.map((l) => (
                    <li>
                      <a href={l.href} class="transition-colors hover:text-brand-300">
                        {l.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            ))
          }

          <div>
            <p class="font-display font-semibold text-white">Get in touch</p>
            <address class="mt-5 flex flex-col gap-4 text-[0.95rem] not-italic">
              <a href={contact.phoneHref} class="flex gap-3 transition-colors hover:text-brand-300">
                <Phone class="mt-0.5 size-[18px] shrink-0 text-brand-400" stroke-width="1.75" />
                <span class="tabular-nums">{contact.phone}</span>
              </a>
              <a href={contact.mapsHref} target="_blank" rel="noopener" class="flex gap-3 transition-colors hover:text-brand-300">
                <MapPin class="mt-0.5 size-[18px] shrink-0 text-brand-400" stroke-width="1.75" />
                <span>
                  {contact.address[0]}
                  <br />
                  {contact.address[1]}
                </span>
              </a>
              <a href={`mailto:${contact.email}`} class="flex gap-3 break-all transition-colors hover:text-brand-300">
                <Mail class="mt-0.5 size-[18px] shrink-0 text-brand-400" stroke-width="1.75" />
                {contact.email}
              </a>
              <span class="flex gap-3 text-brand-100/70">
                <Clock class="mt-0.5 size-[18px] shrink-0 text-brand-400" stroke-width="1.75" />
                {contact.hours}
              </span>
            </address>
          </div>
        </div>
      </div>

      <!-- Legal + redes -->
      <div class="flex flex-col-reverse gap-6 border-t border-white/10 py-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-xs text-brand-100/60">© {year} Nex‑Gen Management, LLC. All rights reserved. · Equal Housing Opportunity</p>
        <ul class="flex gap-2">
          {
            social.map((s) => {
              const Icon = icons[s.icon];
              return (
                <li>
                  <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} class="grid size-10 place-items-center rounded-full bg-white/8 text-white transition-colors hover:bg-brand-400 hover:text-brand-950">
                    <Icon class="size-[18px]" stroke-width="1.75" />
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </div>
</footer>

<script>
  import { onEveryPage } from '@/scripts/lifecycle';

  // Suscripción: valida el email; el envío aún no está conectado a ningún servicio de newsletter
  onEveryPage(() => {
    const form = document.querySelector<HTMLFormElement>('[data-newsletter]');
    const status = form?.querySelector<HTMLElement>('[data-newsletter-status]');
    const input = form?.querySelector<HTMLInputElement>('input[type="email"]');
    if (!form || !status || !input) return;

    const onSubmit = (e: SubmitEvent) => {
      e.preventDefault();
      if (!input.checkValidity()) {
        status.dataset.tone = 'error';
        status.textContent = 'Enter a valid email address.';
        input.focus();
        return;
      }
      status.dataset.tone = 'info';
      status.textContent = 'Thanks! Newsletter sign-up is not connected yet.';
    };
    form.addEventListener('submit', onSubmit);
    return () => form.removeEventListener('submit', onSubmit);
  });
</script>
