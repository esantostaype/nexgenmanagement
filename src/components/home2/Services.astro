---
import Img from '@/components/Img.astro';
import Building from '@tabler/icons/outline/building.svg';
import ReportAnalytics from '@tabler/icons/outline/report-analytics.svg';
import Search from '@tabler/icons/outline/zoom-money.svg';
import Bulb from '@tabler/icons/outline/bulb.svg';
import Check from '@tabler/icons/outline/check.svg';
import ArrowUpRight from '@tabler/icons/outline/arrow-up-right.svg';
import { serviceLines } from '@/data/site';

const icons = [Building, ReportAnalytics, Search, Bulb];
---

<!-- Layout inspirado en "We Champion the Bold" (Finovate) -->
<section id="services" class="scroll-mt-28 px-4 pt-24 md:pt-32" aria-labelledby="services-title">
  <div class="rounded-2xl bg-white py-20 md:py-28">
    <div class="container-site">
      <div class="mx-auto max-w-3xl text-center">
        <h2 id="services-title" class="font-display text-[clamp(2.2rem,4.4vw,3.8rem)] leading-[1.02] font-semibold tracking-[-0.035em] text-balance text-brand-950" data-scene="split-lines">
          Everything an owner needs, run by one team.
        </h2>
        <p class="mx-auto mt-5 max-w-[52ch] text-lg text-neutral-600" data-reveal data-delay="0.15">
          From the first walkthrough of an acquisition to the weekly report on a stabilized asset.
        </p>
      </div>

      <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
        {
          serviceLines.map((line, i) => {
            const Icon = icons[i];
            return (
              <li>
                <a href={line.href} class="group relative flex h-full min-h-[480px] flex-col overflow-hidden rounded-2xl bg-brand-950 text-white">
                  <Img sizes="(min-width: 1024px) 25vw, 50vw"
                    src={line.photo}
                    alt=""
                    width="600"
                    height="800"
                    loading="lazy"
                    class="absolute inset-0 size-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.05]"
                  />
                  <div class="absolute inset-0 bg-linear-to-t from-brand-950 via-brand-950/70 to-brand-950/0" aria-hidden="true" />
                  <span class="relative m-5 grid size-12 place-items-center rounded-full bg-brand-400 text-brand-950">
                    <Icon class="size-6" stroke-width="1.75" />
                  </span>
                  <div class="relative mt-auto p-6">
                    <h3 class="font-display text-[1.5rem] leading-tight font-semibold tracking-[-0.02em]">{line.title}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-white/80">{line.text}</p>
                    <ul class="mt-4 flex flex-col gap-1.5 text-sm text-white/90">
                      {line.services.map((s) => (
                        <li class="flex items-center gap-2">
                          <Check class="size-4 shrink-0 text-brand-400" stroke-width="2" />
                          {s}
                        </li>
                      ))}
                    </ul>
                    <span class="mt-6 flex items-center justify-between border-t border-white/15 pt-4 text-sm font-medium">
                      Learn more
                      <span class="grid size-9 place-items-center rounded-full bg-white text-brand-950 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] rotate-45 group-hover:rotate-0">
                        <ArrowUpRight class="size-[18px]" stroke-width="1.75" />
                      </span>
                    </span>
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>
