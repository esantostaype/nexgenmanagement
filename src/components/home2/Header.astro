---
import HeaderLogo from '@/components/HeaderLogo.astro';
import Phone from '@tabler/icons/outline/phone.svg';
import Menu from '@tabler/icons/outline/menu-2.svg';
import X from '@tabler/icons/outline/x.svg';
import ArrowUpRight from '@tabler/icons/outline/arrow-up-right.svg';
import ChevronDown from '@tabler/icons/outline/chevron-down.svg';
import { contact } from '@/data/site';

interface Props {
  /** overlay: transparente sobre el hero, se vuelve sólido al hacer scroll. solid: siempre sólido. */
  variant?: 'overlay' | 'solid';
}

const { variant = 'overlay' } = Astro.props;

// Mismo menú que el sitio actual. Los elementos sin `href` aún no tienen página: se muestran como texto,
// sin enlace. Al crear la página, añade su `href` (y también en las columnas del footer).
type NavItem = { label: string; href?: string };
type NavLink = NavItem & { children?: NavItem[] };
const links: NavLink[] = [
  { label: 'Home', href: '/' },
  { label: 'Our Properties', href: '/our-properties' },
  { label: 'Services', href: '/#services' },
  { label: 'Home Sales' },
  { label: 'About', children: [{ label: 'About us' }, { label: 'Meet the team' }, { label: 'Careers' }] },
  { label: 'Blog' },
  { label: 'Contact' },
];
// Etiqueta: <a> si hay página, <span> si todavía no
const Tag = (item: NavItem) => (item.href ? 'a' : 'span');
---

<header
  data-site-header
  data-variant={variant}
  class="group/header fixed inset-x-0 top-0 z-40 px-4 pt-8 transition-[padding] duration-500 data-[scrolled]:pt-3"
>
  <div class="container-site">
    <div
      class:list={[
        'flex h-16 items-center justify-between rounded-full py-2 transition-[background-color,box-shadow,color,padding] duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]',
        // Transparente: sin padding, alineado con el contenido del hero. Con scroll: píldora blanca con padding.
        variant === 'overlay'
          ? 'px-0 text-white group-data-[scrolled]/header:bg-white group-data-[scrolled]/header:pr-2 group-data-[scrolled]/header:pl-2 group-data-[scrolled]/header:text-brand-950 group-data-[scrolled]/header:shadow-[0_12px_32px_-16px_rgb(7_53_69/0.35)]'
          : 'bg-white pr-2 pl-2 text-brand-950 shadow-[0_12px_32px_-18px_rgb(7_53_69/0.3)]',
      ]}
    >
      <a href="/" class="flex items-center" aria-label="Nex-Gen Management home">
        <HeaderLogo fullHeight={variant === 'overlay' ? 56 : 48} collapse={false} alignCircle={variant === 'overlay'} />
      </a>

      <nav aria-label="Main" class="hidden lg:block">
        <ul class="flex items-center gap-1">
          {
            links.map((link) =>
              link.children ? (
                <li class="group/sub relative">
                  <button type="button" class="inline-flex cursor-default items-center gap-1 rounded-full px-3.5 py-2 text-[0.92rem] opacity-90 transition-[background-color,opacity] hover:bg-current/10 hover:opacity-100" aria-haspopup="true">
                    {link.label}
                    <ChevronDown class="size-4 transition-transform duration-300 group-hover/sub:rotate-180 group-focus-within/sub:rotate-180" stroke-width="2" />
                  </button>
                  <!-- Desplegable: aparece con hover o al enfocar con teclado -->
                  <div class="invisible absolute top-full left-0 pt-3 opacity-0 transition-[opacity,visibility,translate] duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] translate-y-1 group-hover/sub:visible group-hover/sub:translate-y-0 group-hover/sub:opacity-100 group-focus-within/sub:visible group-focus-within/sub:translate-y-0 group-focus-within/sub:opacity-100">
                    <ul class="min-w-48 rounded-2xl bg-white p-2 text-brand-950 shadow-[0_24px_48px_-20px_rgb(7_53_69/0.4)]">
                      {link.children.map((child) => {
                        const C = Tag(child);
                        return (
                          <li>
                            <C href={child.href} class:list={['block rounded-xl px-3.5 py-2.5 text-[0.92rem]', child.href ? 'transition-colors hover:bg-brand-50' : 'cursor-default text-neutral-400']}>
                              {child.label}
                            </C>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                </li>
              ) : link.href ? (
                <li>
                  <a href={link.href} class="rounded-full px-3.5 py-2 text-[0.92rem] opacity-90 transition-[background-color,opacity] hover:bg-current/10 hover:opacity-100">
                    {link.label}
                  </a>
                </li>
              ) : (
                <li>
                  <span class="cursor-default rounded-full px-3.5 py-2 text-[0.92rem] opacity-60">{link.label}</span>
                </li>
              ),
            )
          }
        </ul>
      </nav>

      <div class="flex items-center">
        <a
          href={contact.phoneHref}
          class="hidden h-12 items-center gap-2.5 rounded-full px-5 text-[0.95rem] font-medium ring-1 ring-current/30 transition-colors hover:bg-current/10 md:inline-flex"
          aria-label={`Call ${contact.phone}`}
        >
          <Phone class="size-[18px]" stroke-width="1.75" />
          <span class="hidden tabular-nums xl:inline">{contact.phone}</span>
          <span class="xl:hidden">Call us</span>
        </a>

        <!-- "Get a proposal": oculto mientras el botón del hero está en pantalla; Motion anima su ancho (home.ts) -->
        <div class="hidden overflow-hidden sm:block" style="width:0" data-header-cta aria-hidden="true">
          <div class="pl-2">
            <a
              href="/contact"
              tabindex="-1"
              class="group inline-flex h-12 items-center gap-3 rounded-full bg-brand-400 pr-1.5 pl-5 text-[0.95rem] font-medium whitespace-nowrap text-brand-950 transition-colors hover:bg-brand-300"
              data-header-cta-link
            >
              Get a proposal
              <span class="grid size-9 place-items-center rounded-full bg-brand-950 text-brand-300 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] rotate-45 group-hover:rotate-0">
                <ArrowUpRight class="size-[18px]" stroke-width="1.75" />
              </span>
            </a>
          </div>
        </div>

        <button
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="ml-2 grid size-12 place-items-center rounded-full bg-brand-950 text-white lg:hidden"
        >
          <span class="sr-only">Open menu</span>
          <Menu class="size-5 [[aria-expanded=true]>&]:hidden" stroke-width="1.75" />
          <X class="hidden size-5 [[aria-expanded=true]>&]:block" stroke-width="1.75" />
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    data-open="false"
    class="pointer-events-none fixed inset-x-4 top-28 max-h-[calc(100svh-8rem)] origin-top overflow-y-auto scale-[0.97] rounded-2xl bg-brand-950 p-6 text-white opacity-0 transition-[opacity,transform] duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] data-[open=true]:pointer-events-auto data-[open=true]:scale-100 data-[open=true]:opacity-100 lg:hidden"
  >
    <ul class="flex flex-col">
      {
        links.map((link) => (
          <li class="border-b border-white/10">
            {link.href ? (
              <a href={link.href} class="font-display block py-3.5 text-2xl font-semibold tracking-tight">
                {link.label}
              </a>
            ) : (
              <span class:list={['font-display block py-3.5 text-2xl font-semibold tracking-tight', !link.children && 'text-white/45']}>{link.label}</span>
            )}
            {link.children && (
              <ul class="-mt-1 flex flex-col gap-1 pb-4 pl-4">
                {link.children.map((child) => (
                  <li>
                    {child.href ? (
                      <a href={child.href} class="block py-1 text-white/75">
                        {child.label}
                      </a>
                    ) : (
                      <span class="block py-1 text-white/40">{child.label}</span>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
    <a href="/contact" class="mt-6 flex h-14 items-center justify-between rounded-full bg-brand-400 pr-2 pl-6 font-medium text-brand-950">
      Get a proposal
      <span class="grid size-10 place-items-center rounded-full bg-brand-950 text-brand-300"><ArrowUpRight class="size-[18px]" stroke-width="1.75" /></span>
    </a>
  </div>
</header>
