---
import Img from '@/components/Img.astro';
import ArrowUpRight from '@tabler/icons/outline/arrow-up-right.svg';
import Calendar from '@tabler/icons/outline/calendar.svg';
import { posts } from '@/data/site';

// Tres más recientes (las fechas con solo año van al final de su año)
const sortKey = (d: string) => (d.length === 4 ? `${d}-00-00` : d);
const [featured, ...rest] = [...posts].sort((a, b) => sortKey(b.date).localeCompare(sortKey(a.date))).slice(0, 3);

const parse = (date: string) => (date.length === 4 ? null : new Date(`${date}T12:00:00`));
const badge = (date: string) => {
  const d = parse(date);
  return d ? { day: String(d.getDate()).padStart(2, '0'), month: d.toLocaleString('en-US', { month: 'short' }) } : { day: date, month: 'Year' };
};
// "09 May, 2026"
const longDate = (date: string) => {
  const d = parse(date);
  return d ? `${String(d.getDate()).padStart(2, '0')} ${d.toLocaleString('en-US', { month: 'short' })}, ${d.getFullYear()}` : date;
};
const b = badge(featured.date);
---

<!-- Destacado grande a la izquierda (foto completa, fecha y título encima) y dos posts apilados a la derecha -->
<section id="news" class="scroll-mt-28 pt-24 md:pt-32" aria-labelledby="news-title">
  <div class="container-site">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 id="news-title" class="font-display text-[clamp(2.2rem,4.4vw,3.8rem)] leading-[1.02] font-semibold tracking-[-0.035em] text-brand-950" data-scene="split-lines">
        News and insights.
      </h2>
      <a href="/blog" class="group inline-flex items-center gap-3 font-medium text-brand-950" data-reveal="from-left">
        <span class="border-b border-brand-950/25 pb-0.5 transition-colors group-hover:border-brand-950">All articles</span>
        <ArrowUpRight class="size-5 rotate-45 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:rotate-0" stroke-width="1.75" />
      </a>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <!-- Destacado -->
      <article class="group relative isolate flex min-h-[420px] flex-col justify-end overflow-hidden rounded-2xl p-6 text-white sm:p-8 lg:min-h-[540px]" data-reveal="fade-up">
        <Img sizes="(min-width: 1024px) 50vw, 100vw" src={featured.image} alt="" loading="lazy" class="absolute inset-0 -z-10 size-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.04]" />
        <span class="absolute inset-0 -z-10 bg-linear-to-t from-brand-950/85 via-brand-950/25 to-transparent" aria-hidden="true"></span>
        <span class="absolute top-6 left-6 flex flex-col items-center rounded-xl bg-brand-400 px-4 py-3 leading-none text-brand-950 sm:top-8 sm:left-8">
          <span class="font-display text-3xl font-semibold tabular-nums">{b.day}</span>
          <span class="mt-1.5 text-xs font-semibold tracking-wide uppercase">{b.month}</span>
        </span>
        <span class="w-fit rounded-full bg-brand-500 px-4 py-1.5 text-sm font-medium text-brand-950">{featured.category}</span>
        <h3 class="font-display mt-4 max-w-[22ch] text-[clamp(1.6rem,2.6vw,2.2rem)] leading-[1.12] font-semibold tracking-[-0.02em] text-balance">
          <a href={featured.href} class="after:absolute after:inset-0">{featured.title}</a>
        </h3>
      </article>

      <!-- Dos posts: foto + fecha, categoría, título y "Explore more" -->
      <ul class="grid gap-6" data-reveal-stagger>
        {
          rest.map((post) => (
            <li>
              <article class="group grid h-full items-center gap-6 sm:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]">
                <a href={post.href} class="block aspect-[4/3] overflow-hidden rounded-2xl sm:aspect-auto sm:h-full sm:min-h-[240px]" tabindex="-1" aria-hidden="true">
                  <Img sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" src={post.image} alt="" loading="lazy" class="size-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.05]" />
                </a>
                <div>
                  <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-neutral-600">
                    <span class="inline-flex items-center gap-1.5">
                      <Calendar class="size-4 text-brand-500" stroke-width="1.75" />
                      {longDate(post.date)}
                    </span>
                    <span class="h-px w-3 bg-neutral-400" aria-hidden="true" />
                    <span>{post.category}</span>
                  </p>
                  <h3 class="font-display mt-3 text-[1.35rem] leading-snug font-semibold tracking-[-0.015em] text-balance text-brand-950">
                    <a href={post.href}>{post.title}</a>
                  </h3>
                  <a href={post.href} class="mt-6 inline-flex items-center gap-3 font-medium text-brand-950" aria-label={`Explore more: ${post.title}`}>
                    Explore more
                    <span class="grid size-11 place-items-center rounded-full bg-brand-950 text-white transition-colors group-hover:bg-brand-500 group-hover:text-brand-950">
                      <ArrowUpRight class="size-5 rotate-45 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:rotate-0" stroke-width="1.75" />
                    </span>
                  </a>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
