---
import Img from '@/components/Img.astro';
// Servicios: a la izquierda eyebrow, título y descripción fijos (sticky); a la derecha las 9 tarjetas
// en dos columnas. La segunda columna (4 tarjetas) baja algo más despacio que la primera (5) para que
// ambas terminen a la misma altura (home.ts, [data-svc-cols]).
import ArrowUpRight from '@tabler/icons/outline/arrow-up-right.svg';
import FileSearch from '@tabler/icons/outline/file-search.svg';
import BuildingEstate from '@tabler/icons/outline/building-estate.svg';
import Bulb from '@tabler/icons/outline/bulb.svg';
import Calculator from '@tabler/icons/outline/calculator.svg';
import FileInvoice from '@tabler/icons/outline/file-invoice.svg';
import ReportAnalytics from '@tabler/icons/outline/report-analytics.svg';
import ReportMoney from '@tabler/icons/outline/report-money.svg';
import ClipboardCheck from '@tabler/icons/outline/clipboard-check.svg';
import Folders from '@tabler/icons/outline/folders.svg';
import { services } from '@/data/site';

const icons: Record<string, typeof FileSearch> = {
  'file-search': FileSearch,
  'building-estate': BuildingEstate,
  bulb: Bulb,
  calculator: Calculator,
  'file-invoice': FileInvoice,
  'report-analytics': ReportAnalytics,
  'report-money': ReportMoney,
  'clipboard-check': ClipboardCheck,
  folders: Folders,
};

// Columna A: servicios 1, 3, 5, 7, 9 · Columna B: 2, 4, 6, 8. En móvil las columnas se disuelven
// (display: contents) y `order` devuelve las tarjetas a la secuencia del ciclo de la inversión.
const columns = [services.filter((_, i) => i % 2 === 0), services.filter((_, i) => i % 2 === 1)];
// Todas las tarjetas con el mismo neutral de Tailwind (gris puro)
const tint = (_i: number) => 'bg-neutral-100';
---

<section id="services" class="scroll-mt-28 px-4 pt-24 md:pt-32" aria-labelledby="services-title">
  <div class="rounded-2xl bg-white py-20 md:py-28">
    <div class="container-site grid gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Columna fija -->
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-32">
          <span class="inline-block rounded-md bg-brand-50 px-3 py-1.5 text-sm font-semibold tracking-[0.12em] text-brand-700 uppercase" data-reveal="fade">
            Our services
          </span>
          <h2 id="services-title" class="font-display mt-6 text-[clamp(2.2rem,3.6vw,3.4rem)] leading-[1.04] font-semibold tracking-[-0.03em] text-balance text-brand-950" data-scene="split-lines">
            Protecting your investment, while maximizing its potential.
          </h2>
          <p class="mt-6 max-w-[42ch] text-lg leading-relaxed text-neutral-600" data-reveal data-delay="0.15">
            Nine services that cover the full life of a multifamily asset: from due diligence and acquisition to
            budgets, weekly reports, monthly financials and yearly inspections.
          </p>
          <a
            href="/contact"
            class="group mt-9 inline-flex h-14 items-center gap-4 rounded-full bg-brand-950 pr-2 pl-6 font-medium text-white transition-colors hover:bg-brand-900"
            data-reveal="from-left"
            data-delay="0.25"
          >
            Request a proposal
            <span class="grid size-10 place-items-center rounded-full bg-brand-400 text-brand-950 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] rotate-45 group-hover:rotate-0">
              <ArrowUpRight class="size-[18px]" stroke-width="1.75" />
            </span>
          </a>
        </div>
      </div>

      <!-- Tarjetas en dos columnas -->
      <div class="grid items-start gap-5 sm:grid-cols-2 lg:col-span-8" data-svc-cols>
        {
          columns.map((col, c) => (
            <ul class="contents sm:flex sm:flex-col sm:gap-5" data-svc-col={c}>
              {col.map((svc, i) => {
                const Icon = icons[svc.icon];
                return (
                  <li style={`order:${i * 2 + c}`} data-reveal>
                    <a href={`/services/${svc.slug}`} class:list={['group flex flex-col rounded-2xl p-5 sm:p-6', tint(i + c)]}>
                      <span class="flex items-start justify-between gap-4">
                        <span class="flex flex-wrap gap-1.5">
                          {svc.tags.map((t) => (
                            <span class="rounded-full bg-white px-3.5 py-1.5 text-xs font-medium text-brand-950">{t}</span>
                          ))}
                        </span>
                        <span class="grid size-11 shrink-0 place-items-center rounded-full bg-white text-brand-700">
                          <Icon class="size-[22px]" stroke-width="1.6" />
                        </span>
                      </span>
                      <span class="font-display mt-8 text-[clamp(1.6rem,2.2vw,2rem)] leading-[1.05] font-semibold tracking-[-0.025em] text-balance text-brand-950">
                        {svc.title}
                      </span>
                      <span class="mt-3 text-[0.95rem] leading-relaxed text-neutral-600">{svc.text}</span>
                      <span class="relative mt-6 block aspect-[4/3] overflow-hidden rounded-2xl">
                        <Img sizes="(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw"
                          src={svc.image}
                          alt=""
                          width="900"
                          height="675"
                          loading="lazy"
                          class="absolute inset-0 size-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.05]"
                        />
                        <span class="absolute bottom-4 left-4 inline-flex items-center gap-3 rounded-full bg-brand-950/45 py-1.5 pr-1.5 pl-4 text-sm font-medium text-white backdrop-blur-md">
                          Read more
                          <span class="grid size-8 place-items-center rounded-full bg-white text-brand-950 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]">
                            <ArrowUpRight class="size-4 rotate-45 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:rotate-0" stroke-width="2" />
                          </span>
                        </span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          ))
        }
      </div>
    </div>
  </div>
</section>
