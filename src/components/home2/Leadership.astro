---
import Img from '@/components/Img.astro';
import Quote from '@tabler/icons/filled/quote.svg';
---

<!-- Cita de la dirección: quote a la izquierda, Billi Jo a la derecha con la cabeza sobresaliendo
     de la tarjeta y el torso pegado al borde inferior -->
<section class="px-4 pt-24 md:pt-32" aria-labelledby="leadership-quote">
  <figure class="relative mx-auto grid max-w-5xl rounded-2xl bg-white md:min-h-[420px] md:grid-cols-[1.4fr_1fr]" data-reveal="fade">
    <!-- Ondas (círculos concéntricos) detrás de la persona, recortadas por la tarjeta.
         Crecen una tras otra, de la pequeña a la grande, al entrar en pantalla (home.ts, [data-ripples]) -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-2xl" aria-hidden="true" data-ripples>
      <span class="absolute bottom-0 left-1/2 size-[680px] translate-x-[-50%] translate-y-[42%] rounded-full bg-brand-50 md:left-[86%]" data-ripple></span>
      <span class="absolute bottom-0 left-1/2 size-[460px] translate-x-[-50%] translate-y-[42%] rounded-full bg-brand-100 md:left-[86%]" data-ripple></span>
      <span class="absolute bottom-0 left-1/2 size-[280px] translate-x-[-50%] translate-y-[42%] rounded-full bg-brand-200 md:left-[86%]" data-ripple></span>
    </div>

    <div class="relative z-10 flex flex-col justify-center p-8 sm:p-12 md:py-16 md:pr-4 md:pl-14">
      <Quote class="size-9 text-brand-500" data-reveal="scale" />
      <blockquote id="leadership-quote" class="font-display mt-6 text-[clamp(1.6rem,3vw,2.35rem)] leading-[1.15] font-medium tracking-[-0.02em] text-pretty text-brand-950" data-scene="split-lines">
        Great things in business are never done by one <span class="text-brand-500">person<span class="text-brand-950">.</span></span> They’re done by a <span class="text-brand-500">team</span> of people.
      </blockquote>
      <figcaption class="mt-8 flex items-center gap-4" data-reveal="from-left" data-delay="0.2">
        <span class="h-px w-10 bg-brand-950/20" aria-hidden="true"></span>
        <span>
          <span class="block font-semibold text-brand-950">Billi Jo Suiter</span>
          <span class="block text-sm text-neutral-500">CEO &amp; Owner, Nex-Gen Management</span>
        </span>
      </figcaption>
    </div>

    <!-- Persona: el contenedor sube por encima de la tarjeta (cabeza fuera) y recorta abajo, a ras del borde -->
    <div class="relative h-[420px] md:h-auto">
      <div class="absolute inset-x-0 top-0 bottom-0 overflow-hidden rounded-b-2xl md:-top-12 md:rounded-bl-none">
        <Img
          src="/images/brand/billi-jo-suiter.png"
          alt="Billi Jo Suiter, CEO and owner of Nex-Gen Management"
          sizes="350px"
          loading="lazy"
          class="absolute top-0 left-1/2 w-[300px] max-w-none -translate-x-1/2 md:w-[350px]"
          data-reveal="fade-up"
        />
      </div>

    </div>
  </figure>
</section>

<style>
  /* Las ondas empiezan sin tamaño solo si hay JS y movimiento; si no, se ven tal cual */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) [data-ripples]:not([data-shown]) [data-ripple] {
      transform: scale(0);
    }
  }
</style>
