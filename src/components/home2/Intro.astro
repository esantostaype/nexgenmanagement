---
import Img from '@/components/Img.astro';
import ArrowUpRight from '@tabler/icons/outline/arrow-up-right.svg';
import { award, photos } from '@/data/site';
import { communities, states } from '@/data/communities';

const cards = [
  {
    tag: 'Who we are',
    title: `A Clarksville operator running ${communities.length} properties across ${states.join(', ')}.`,
    href: '#about',
    image: '/images/properties/the-oakley-at-pro-park.webp',
    alt: 'Grilling pavilion at The Oakley at Pro Park, Clarksville',
  },
  {
    tag: 'Recognition',
    title: `${award.title}, ${award.by}.`,
    href: '#news',
    image: award.photo,
    alt: 'Nex-Gen team receiving the Management Company of the Year award',
    featured: true,
  },
  {
    tag: 'For owners',
    title: 'Your asset on one page, every week, with monthly financials.',
    href: '#services',
    image: photos.kitchen.src,
    alt: photos.kitchen.alt,
  },
];
---

<section class="pt-24 md:pt-32" aria-label="About Nex-Gen at a glance">
  <ul class="container-site grid gap-4 md:grid-cols-3" data-reveal-stagger>
    {
      cards.map((card) => (
        <li>
          <a
            href={card.href}
            class:list={[
              'group flex h-full min-h-[460px] flex-col rounded-2xl p-6 transition-colors duration-300',
              card.featured ? 'bg-brand-400 text-brand-950 hover:bg-brand-300' : 'bg-white text-brand-950 hover:bg-brand-50/60',
            ]}
          >
            <span class="flex items-start justify-between gap-4">
              <span
                class:list={[
                  'rounded-full px-3 py-1 text-xs font-medium tracking-wide uppercase',
                  card.featured ? 'bg-brand-950/10 text-brand-950' : 'bg-neutral-100 text-neutral-600',
                ]}
              >
                {card.tag}
              </span>
              <span
                class:list={[
                  'grid size-11 shrink-0 place-items-center rounded-full transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] rotate-45 group-hover:rotate-0',
                  card.featured ? 'bg-brand-950 text-brand-300' : 'bg-white text-brand-950 ring-1 ring-brand-950/10',
                ]}
              >
                <ArrowUpRight class="size-5" stroke-width="1.75" />
              </span>
            </span>
            <span class="font-display mt-5 text-[1.45rem] leading-snug font-semibold tracking-[-0.02em] text-balance">{card.title}</span>
            <span class="relative mt-auto block aspect-[4/3] overflow-hidden rounded-2xl pt-6">
              <Img sizes="(min-width: 768px) 33vw, 100vw"
                src={card.image}
                alt={card.alt}
                width="600"
                height="450"
                loading="lazy"
                class="absolute inset-0 size-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.04]"
              />
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
