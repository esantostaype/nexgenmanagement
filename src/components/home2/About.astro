---
import Img from '@/components/Img.astro';
import BuildingCommunity from '@tabler/icons/outline/building-community.svg';
import MapPin from '@tabler/icons/outline/map-pin.svg';
import Route from '@tabler/icons/outline/route.svg';
import ArrowUpRight from '@tabler/icons/outline/arrow-up-right.svg';
import Plus from '@tabler/icons/outline/plus.svg';
import { communities, cities, states } from '@/data/communities';
import { team } from '@/data/site';

const initials = (name: string) =>
  name
    .split(' ')
    .map((p) => p[0])
    .slice(0, 2)
    .join('');

const counters = [
  { icon: BuildingCommunity, step: '01', label: 'Properties under management', value: communities.length },
  { icon: MapPin, step: '02', label: 'Cities where our teams work', value: cities.length },
  { icon: Route, step: '03', label: 'States: Tennessee, Kentucky, Alabama', value: states.length },
];
---

<!-- Layout de la sección "About" de Bexon (index-2) -->
<section id="about" class="scroll-mt-28 pt-24 md:pt-32" aria-labelledby="about-title">
  <div class="container-site grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      counters.map((c, i) => (
        <div
          class:list={[
            'flex min-h-[250px] flex-col justify-between rounded-2xl bg-white p-8 md:min-h-[340px]',
            i === 0 ? 'order-3 md:order-2 lg:order-1' : i === 1 ? 'order-4' : 'order-5',
          ]}
          data-reveal
          data-delay={String(i * 0.1)}
        >
          <div class="flex items-start justify-between">
            <span class="grid size-20 place-items-center rounded-full bg-neutral-100 text-brand-700">
              <c.icon class="size-9" stroke-width="1.5" />
            </span>
            <span class="font-display text-lg font-medium text-neutral-600 tabular-nums">{c.step}.</span>
          </div>
          <div>
            <p class="text-neutral-600">{c.label}</p>
            <p class="font-display mt-3 text-[clamp(3.5rem,6vw,5.25rem)] leading-none font-medium tracking-[-0.04em] text-brand-950 tabular-nums" data-count={c.value}>
              {c.value}
            </p>
          </div>
        </div>
      ))
    }

    <!-- Bloque principal, sin caja: texto sobre el fondo + imagen vertical (Clarksville al atardecer) -->
    <div class="order-1 flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between md:col-span-2 lg:order-2 lg:pl-10">
      <div class="max-w-[620px]">
        <span class="inline-block rounded-md bg-white px-3 py-1.5 text-sm font-semibold tracking-[0.12em] text-brand-700 uppercase" data-reveal="fade">
          Get to know us
        </span>
        <h2 id="about-title" class="font-display mt-6 text-[clamp(2.1rem,3.8vw,3.4rem)] leading-[1.08] font-medium tracking-[-0.03em] text-balance text-brand-950" data-scene="split-lines">
          A regional operator, close to every property: your partner for properties that stay cared for.
        </h2>
        <a href="/about" class="group mt-9 inline-flex items-center gap-3 font-medium text-brand-950" data-reveal="from-left" data-delay="0.2">
          Learn more
          <span class="grid size-9 place-items-center rounded-full bg-brand-950 text-white transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] rotate-45 group-hover:rotate-0">
            <ArrowUpRight class="size-[18px]" stroke-width="1.75" />
          </span>
        </a>
      </div>

      <figure class="relative h-[320px] w-full shrink-0 overflow-hidden rounded-2xl sm:w-[150px]" data-reveal="scale">
        <Img
          src="/images/gallery/clarksville-sunset.jpg"
          alt="Downtown Clarksville, Tennessee at sunset, home of Nex-Gen Management"
          sizes="(min-width: 640px) 430px, 100vw"
          loading="lazy"
          class="absolute inset-0 size-full object-cover"
          data-parallax
        />
      </figure>
    </div>

    <!-- Equipo -->
    <div class="relative order-2 flex min-h-[340px] flex-col justify-between overflow-hidden rounded-2xl bg-linear-45 from-brand-600 to-brand-500 p-8 text-white md:order-3" data-reveal>
      <ul class="relative flex -space-x-2.5" aria-label="Part of our team">
        {
          team.slice(0, 3).map((m) =>
            'photo' in m && m.photo ? (
              <li class="size-10 overflow-hidden rounded-full bg-brand-50 ring-2 ring-white">
                <Img src={m.photo} alt={m.name} sizes="40px" loading="lazy" class="size-full object-cover object-top" />
              </li>
            ) : (
              <li class="font-display grid size-10 place-items-center rounded-full bg-brand-50 text-xs font-semibold text-brand-900 ring-2 ring-white" title={m.name}>
                {initials(m.name)}
              </li>
            ),
          )
        }
        <li class="grid size-10 place-items-center rounded-full bg-brand-950 text-white ring-2 ring-white" aria-hidden="true">
          <Plus class="size-4" stroke-width="2" />
        </li>
      </ul>
      <p class="font-display relative max-w-[16ch] text-2xl leading-snug font-semibold tracking-tight">A team of {team.length} people, based in Clarksville.</p>
    </div>
  </div>
</section>
